<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    mc:Ignorable="d" x:Class="PageWeb">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBack" Grid.Column="0" Style="{StaticResource BtnBase}" Width="32" Height="30" Padding="0"
                    Content="‹" FontSize="16" ToolTip="后退" IsEnabled="False" />
            <Button x:Name="BtnForward" Grid.Column="1" Style="{StaticResource BtnBase}" Width="32" Height="30" Padding="0" Margin="6,0,0,0"
                    Content="›" FontSize="16" ToolTip="前进" IsEnabled="False" />
            <Button x:Name="BtnRefresh" Grid.Column="2" Style="{StaticResource BtnBase}" Height="30" MinWidth="46" Padding="10,0" Margin="6,0,0,0"
                    Content="刷新" FontSize="12" ToolTip="重新加载当前网页" />
            <local:MyTextBox x:Name="TxtAddress" Grid.Column="3" Height="30" Margin="10,0,10,0"
                             HintText="输入网址或搜索词，回车访问" />
            <Button x:Name="BtnExternal" Grid.Column="4" Style="{StaticResource BtnBase}" Height="30" Padding="10,0"
                    Content="在浏览器打开" FontSize="12" ToolTip="用系统默认浏览器打开当前网页" />
        </Grid>

        <!-- 网页容器 -->
        <Border Grid.Row="1" x:Name="PanWebCard" Style="{StaticResource Card}" Margin="24,0,24,20" Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 顶部加载进度条：导航期间显示，不遮挡网页内容 -->
                <Border Grid.Row="0" x:Name="PanProgress" Height="3" ClipToBounds="True" Visibility="Collapsed">
                    <ProgressBar x:Name="BarProgress" IsIndeterminate="True" Height="3" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource ColorBrush3}" />
                </Border>
                <Grid Grid.Row="1">
                    <!-- WebView2 是原生句柄控件，不参与 WPF 动画：首次加载完成前保持隐藏，
                         避免“未加载白块”在页面入场动画中凭空出现（显示时机由 NavigationCompleted 驱动） -->
                    <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />
                    <!-- 仅在初始化 / 加载失败等致命状态显示整页提示 -->
                    <Border x:Name="PanState" Background="{DynamicResource BrushSurface}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Center"
                                    Background="{DynamicResource BrushAccentSoft2}">
                                <Path Data="M8,1.5 a6.5,6.5 0 1 0 0,13 a6.5,6.5 0 0 0 0,-13 Z M1.5,8 h13 M8,1.5 c2.3,1.8 3.4,4 3.4,6.5 c0,2.5 -1.1,4.7 -3.4,6.5 c-2.3,-1.8 -3.4,-4 -3.4,-6.5 c0,-2.5 1.1,-4.7 3.4,-6.5 Z"
                                      Stroke="{DynamicResource ColorBrush3}" StrokeThickness="1.4" Fill="Transparent"
                                      Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="LabState" Text="正在加载…" FontSize="13" Foreground="{DynamicResource BrushText2}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</local:MyPageRight>
