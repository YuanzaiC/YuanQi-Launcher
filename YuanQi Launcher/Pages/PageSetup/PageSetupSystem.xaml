<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupSystem"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="24,22,24,26">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,16">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="下载来源、速度与 Mod 名称显示" Style="{StaticResource PageSub}" />
            </StackPanel>

            <local:MyCard Margin="0,15" Title="下载来源">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,0,0,12"
                        Text="官方源稳但慢，镜像源快但可能缺新版本；不确定就保持默认。" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="游戏文件" VerticalAlignment="Center" Width="110" />
                        <local:MyComboBox Height="32" x:Name="ComboDownloadSource" local:SettingService.Key="ToolDownloadSource" Width="300" HorizontalAlignment="Left"
                                          ToolTip="下载游戏本体时优先用哪个源">
                            <local:MyComboBoxItem Content="尽量使用镜像源" />
                            <local:MyComboBoxItem Content="优先官方源，加载慢时换镜像源" IsSelected="True" />
                            <local:MyComboBoxItem Content="尽量使用官方源" />
                        </local:MyComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="版本列表" VerticalAlignment="Center" Width="110" />
                        <local:MyComboBox Height="32" x:Name="ComboDownloadVersion" local:SettingService.Key="ToolDownloadVersion" Width="300" HorizontalAlignment="Left"
                                          ToolTip="获取版本号列表时优先用哪个源">
                            <local:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚更新的版本）" />
                            <local:MyComboBoxItem Content="优先官方源，加载慢时换镜像源" IsSelected="True" />
                            <local:MyComboBoxItem Content="尽量使用官方源" />
                        </local:MyComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Mod 文件" VerticalAlignment="Center" Width="110" />
                        <local:MyComboBox Height="32" x:Name="ComboDownloadMod" local:SettingService.Key="ToolDownloadMod" Width="300" HorizontalAlignment="Left"
                                          ToolTip="下载 Mod 时优先用哪个源">
                            <local:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚更新的版本）" />
                            <local:MyComboBoxItem Content="仅在官方源加载缓慢时改用镜像源" />
                            <local:MyComboBoxItem Content="尽量使用官方源" IsSelected="True" />
                        </local:MyComboBox>
                    </StackPanel>
                    <local:MyCheckBox Height="24" Text="连接 CurseForge" x:Name="CheckDownloadCurseForge" local:SettingService.Key="ToolDownloadCurseForge"
                                      ToolTip="关闭后搜索资源时会跳过 CurseForge" />
                    <local:MyCheckBox Height="28" Text="正版登录时验证 SSL 证书" local:SettingService.Key="ToolDownloadCert" ToolTip="开启后校验登录连接的证书，更安全；个别网络环境下会导致正版登录失败，若提示“未能为 SSL/TLS 安全通道建立信任关系”，关掉此项即可。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="下载速度">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="并发线程" VerticalAlignment="Center" Width="110" />
                        <local:MySlider x:Name="SliderDownloadThread" local:SettingService.Key="ToolDownloadThread" MaxValue="255" Value="63" Width="300" HorizontalAlignment="Left"
                                        ToolTip="线程越多同时下的文件越多，但太高会明显卡顿" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="速度上限" VerticalAlignment="Center" Width="110" />
                        <local:MySlider x:Name="SliderDownloadSpeed" local:SettingService.Key="ToolDownloadSpeed" MaxValue="42" Value="42" Width="300" HorizontalAlignment="Left"
                                        ToolTip="限制下载占用的带宽，避免边玩边下时卡" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="游戏版本提醒">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,0,0,10"
                        Text="官网发布新版本时在左下角提示。" />
                    <local:MyCheckBox Text="有新的正式版时提示" Height="24" x:Name="CheckUpdateRelease" local:SettingService.Key="ToolUpdateRelease"
                                      ToolTip="官方发布新的正式版（Release）时提示" />
                    <local:MyCheckBox Text="有新的快照版时提示" Height="24" Margin="0,6,0,0" x:Name="CheckUpdateSnapshot" local:SettingService.Key="ToolUpdateSnapshot"
                                      ToolTip="官方发布新的快照（Snapshot）时提示" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="Mod 名称显示">
                <StackPanel Margin="25,40,25,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="翻译样式" VerticalAlignment="Center" Width="110" />
                        <local:MyComboBox Height="32" x:Name="ComboDownloadTranslateV2" local:SettingService.Key="ToolDownloadTranslateV2" Width="300" HorizontalAlignment="Left"
                                          ToolTip="Mod 中文名的拼接方式，按喜好选">
                            <local:MyComboBoxItem Content="【机械动力】create-1.21.1-6.0.4" />
                            <local:MyComboBoxItem Content="[机械动力] create-1.21.1-6.0.4" IsSelected="True" />
                            <local:MyComboBoxItem Content="机械动力-create-1.21.1-6.0.4" />
                            <local:MyComboBoxItem Content="create-1.21.1-6.0.4-机械动力" />
                            <local:MyComboBoxItem Content="create-1.21.1-6.0.4" />
                        </local:MyComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="列表显示" VerticalAlignment="Center" Width="110" />
                        <local:MyComboBox Height="32" x:Name="ComboModLocalNameStyle" local:SettingService.Key="ToolModLocalNameStyle" Width="300" HorizontalAlignment="Left"
                                          ToolTip="Mod 列表里标题和详情分别显示什么">
                            <local:MyComboBoxItem Content="标题显示译名，详情显示文件名" IsSelected="True" />
                            <local:MyComboBoxItem Content="标题显示文件名，详情显示译名" />
                        </local:MyComboBox>
                    </StackPanel>
                </StackPanel>
            </local:MyCard>




        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
