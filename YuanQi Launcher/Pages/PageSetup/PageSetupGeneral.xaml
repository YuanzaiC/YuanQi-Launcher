<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupGeneral"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="24,22,24,26">
            <StackPanel Orientation="Horizontal" Margin="2,0,0,16">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="更新提醒 · 启动器行为 · 性能 · 设置与体检" Style="{StaticResource PageSub}" />
            </StackPanel>

            <local:MyCard Margin="0,15" Title="启动器更新">
                <StackPanel Margin="25,40,25,20">
                    <local:MyCheckBox Text="启动时自动检测启动器更新" Height="22" x:Name="CheckAutoCheckUpdate" local:SettingService.Key="UiAutoCheckUpdate"
                                      ToolTip="每次打开启动器时检查一次是否有新版本，有新版本会在左下角提示" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <local:MyButton Height="35" x:Name="BtnSystemCheckUpdate" MinWidth="140" Text="立即检查更新" Padding="13,0" HorizontalAlignment="Left"
                            ToolTip="马上检查一次启动器是否有新版本" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="启动器">
                <StackPanel Margin="25,40,25,20">
                    <local:MyCheckBox Text="允许多开启动器" Height="22" x:Name="CheckMultiInstance" local:SettingService.Key="SystemMultiInstance"
                                      ToolTip="同时开多个启动器，便于管理多账号或测试联机" />
                    <local:MyCheckBox x:Name="CheckOpenWebInner" Height="22" Margin="0,6,0,0" Text="在启动器内打开网页" local:SettingService.Key="UiOpenWebInLauncher"
                                      ToolTip="打开网页时用内置浏览器而不是系统浏览器" />
                    <local:MyCheckBox Text="自动设置为中文" Height="22" Margin="0,6,0,0" x:Name="CheckHelpChinese" local:SettingService.Key="ToolHelpChinese"
                                      ToolTip="帮助页面自动切到中文" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="性能">
                <StackPanel Margin="25,40,25,20">
                    <local:MyCheckBox x:Name="CheckWindowAccelerated" local:SettingService.Key="UiWindowAccelerated"
                                      Text="硬件加速（重启生效）" Margin="-1,0,0,10" Height="22"
                                      ToolTip="关闭窗口圆角与外围阴影，换取整窗 GPU 加速；后台跑游戏时更流畅" />
                    <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="1,0,0,12"
                        Text="直角无边框，界面交由显卡绘制，切回启动器更跟手；关闭则保留圆角与阴影。" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="渲染性能" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource ColorBrushGray2}" />
                        <local:MyComboBox x:Name="ComboUiPerfMode" local:SettingService.Key="UiPerfMode" Width="150" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          ToolTip="自动：动画期间加快绘制，掉帧时临时降低阴影与模糊。&#xa;流畅优先：始终按低开销绘制，最省性能。&#xa;画质优先：不做任何自动降级，保持原有观感。">
                            <local:MyComboBoxItem Content="自动（默认）" local:SettingService.Value="0" IsSelected="True" />
                            <local:MyComboBoxItem Content="流畅优先" local:SettingService.Value="1" />
                            <local:MyComboBoxItem Content="画质优先" local:SettingService.Value="2" />
                        </local:MyComboBox>
                    </StackPanel>
                    <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="1,9,0,0"
                        Text="界面动画与阴影的开销；后台跑大型游戏时选「流畅优先」减少掉帧。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="设置与体检">
                <StackPanel Margin="25,40,25,22">
                    <TextBlock FontSize="12" LineHeight="17" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,0,0,12"
                        Text="导出或导入整套设置，也可以检查空间与环境。" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <local:MyButton Height="35" x:Name="BtnSystemSettingExp" MinWidth="140" Text="导出设置" Padding="13,0" Margin="0,0,20,0"
                            ToolTip="把当前设置保存为文件" />
                        <local:MyButton Height="35" x:Name="BtnSystemSettingImp" MinWidth="140" Text="导入设置" Padding="13,0" Margin="0,0,20,0"
                            ToolTip="从导出的设置文件恢复" />
                        <local:MyButton Height="35" x:Name="BtnSystemGuide" MinWidth="140" Text="重新查看使用引导" Padding="13,0"
                            ToolTip="再次打开首次启动时的引导" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton Height="35" x:Name="BtnSystemSpaceAudit" MinWidth="140" Text="空间体检" Padding="13,0" Margin="0,0,20,0"
                            ToolTip="统计各版本占用，列出可清理的内容" />
                        <local:MyButton Height="35" x:Name="BtnSystemEnvCheck" MinWidth="140" Text="环境体检" Padding="13,0" Margin="0,0,20,0"
                            ToolTip="检查 .NET / WebView2 等运行环境是否齐全" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
