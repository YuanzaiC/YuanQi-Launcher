<!-- PageLinkMain —— 联机页：单卡片三层（选择 / 连接中 / 已连接）结构。 -->
<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             mc:Ignorable="d" x:Class="PageLinkMain"
             d:DesignWidth="800" d:DesignHeight="800">
    <Grid x:Name="PanContent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="26,24,0,0">
            <TextBlock Text="联机" Style="{StaticResource PageTitle}" />
            <TextBlock Text="局域网与远程联机" Style="{StaticResource PageSub}" />
        </StackPanel>

        <!-- 同一张卡片，内部三个层随状态互换 -->
        <local:MyCard x:Name="CardMain" HorizontalAlignment="Center" VerticalAlignment="Center" Width="640">
            <Grid Margin="28,26,28,26">

                <!-- ① 选择联机方式 -->
                <StackPanel x:Name="PanSelect" VerticalAlignment="Center">

                    <!-- 主操作：创建房间（浅绿底，一眼看出是主要动作） -->
                    <Border x:Name="PanSelectCreate" Height="92" Cursor="Hand" CornerRadius="14"
                            Background="{StaticResource BrushAccentSoft}" Padding="22,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource ColorBrush3}"
                                  Data="M384 128v192h256a64 64 0 0 1 64 64v256h192V128H384zM320 320V128a64 64 0 0 1 64-64h512a64 64 0 0 1 64 64v512a64 64 0 0 1-64 64h-192v192a64 64 0 0 1-64 64H128a64 64 0 0 1-64-64V384a64 64 0 0 1 64-64h192z m320 384H384a64 64 0 0 1-64-64V384H128v512h512v-192z m0-64V384H384v256h256z" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,10,0">
                                <TextBlock Text="创建房间" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource ColorBrush1}" />
                                <TextBlock Text="我是房主" FontSize="13" Margin="0,5,0,0" Foreground="{StaticResource ColorBrushGray3}" />
                            </StackPanel>
                            <Path Grid.Column="2" Width="7" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                  Stroke="{DynamicResource ColorBrush3}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M0,0 L6,6 L0,12" />
                        </Grid>
                    </Border>

                    <!-- 次操作：加入房间（描边块 + 内嵌输入） -->
                    <Border x:Name="PanSelectJoin" Margin="0,14,0,0" CornerRadius="14" Padding="22,18"
                            Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{StaticResource ColorBrushGray3}"
                                      Data="m399,355l-92.5,101.6c-13.7,13.7-10.6,36.4,4.6,47,13.7,9.1,30.3,7.6,41-4.5l127.4-138.1c16.7-18.2,18.2-47,0-66.8l-125.9-141.1c-12.1-13.7-34.9-15.2-47,0-12.1,12.1-12.1,31.9,0,44l92.5,98.6H28.8c-16.7,0-28.8,13.7-28.8,28.8s13.7,28.8,28.8,28.8h370.2v1.5ZM625.7,0H224.6c-44,0-78.9,34.9-78.9,78.9v101.6c0,15.2,12.1,27.3,27.3,27.3s27.3-12.1,27.3-27.3v-98.6c0-15.2,12.1-27.3,27.3-27.3h387.5c15.2,0,27.3,12.1,27.3,27.3v493c0,15.2-12.1,27.3-27.3,27.3H229.2c-15.2,0-27.3-12.1-27.3-27.3v-101.6c0-16.7-13.7-28.8-28.8-28.8s-28.8,13.7-28.8,28.8v98.6c0,44,34.9,78.9,78.9,78.9h407.2c44,0,67.9-34.9,67.9-78.9V78.9c-4.6-44-28.4-78.9-72.4-78.9Z" />
                                <TextBlock Text="加入房间" FontSize="19" FontWeight="SemiBold" Margin="13,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource ColorBrush1}" />
                                <TextBlock Text="我是访客" FontSize="13" Margin="11,2,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource ColorBrushGray4}" />
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextJoinCode" Height="36" HintText="粘贴邀请码，回车即加入" />
                                <local:MyButton Grid.Column="1" x:Name="BtnJoinInline" Text="加入" Padding="26,8" MinWidth="104"
                                                Margin="10,0,0,0" ColorType="Highlight" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ② 连接中 / 失败 -->
                <Grid x:Name="PanRoom" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 头部：状态图标 + 标题 + 当前阶段 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <local:MyLoading x:Name="Load" Width="46" Height="46" VerticalAlignment="Center" AutoRun="True"
                                         Text="" TextError="" TextErrorInherit="False" IsHitTestVisible="False" />
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="LabLoadTitle" Text="创建房间" FontSize="21" Foreground="{StaticResource ColorBrush1}" />
                            <TextBlock x:Name="LabLoadStage" Text="准备创建房间" FontSize="13" Margin="0,5,0,0" Foreground="{StaticResource ColorBrushGray3}" />
                        </StackPanel>
                    </Grid>

                    <!-- 四步进度轨道 -->
                    <Grid x:Name="StepBar" Grid.Row="1" Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StepDot0" Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Fill="{StaticResource ColorBrush3}" />
                        <Rectangle Grid.Column="1" Height="3" Margin="10,0" VerticalAlignment="Center" Fill="{StaticResource ColorBrushGray6}" />
                        <Ellipse x:Name="StepDot1" Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center" Fill="{StaticResource ColorBrushGray6}" />
                        <Rectangle Grid.Column="3" Height="3" Margin="10,0" VerticalAlignment="Center" Fill="{StaticResource ColorBrushGray6}" />
                        <Ellipse x:Name="StepDot2" Grid.Column="4" Width="14" Height="14" VerticalAlignment="Center" Fill="{StaticResource ColorBrushGray6}" />
                        <Rectangle Grid.Column="5" Height="3" Margin="10,0" VerticalAlignment="Center" Fill="{StaticResource ColorBrushGray6}" />
                        <Ellipse x:Name="StepDot3" Grid.Column="6" Width="14" Height="14" VerticalAlignment="Center" Fill="{StaticResource ColorBrushGray6}" />
                    </Grid>

                    <!-- 当前要做什么：一句醒目的话 -->
                    <TextBlock x:Name="LabLoadDesc" Grid.Row="2" Margin="0,22,0,0" Text="" FontSize="17" FontWeight="SemiBold"
                               LineHeight="24" MaxHeight="80" TextWrapping="Wrap" Foreground="{StaticResource ColorBrush1}" />

                    <local:MyHint x:Name="HintLoad" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed" Text="" Theme="Blue" />

                    <!-- 进度 -->
                    <Grid Grid.Row="4" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0*" x:Name="ColumnProgressA" />
                                <ColumnDefinition Width="1*" x:Name="ColumnProgressB" />
                            </Grid.ColumnDefinitions>
                            <Grid.Clip>
                                <RectangleGeometry RadiusX="3" RadiusY="3" x:Name="RectProgressClip" />
                            </Grid.Clip>
                            <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Fill="{StaticResource ColorBrushGray6}" />
                            <Rectangle Grid.Column="0" Fill="{StaticResource ColorBrush3}" />
                        </Grid>
                        <TextBlock x:Name="LabLoadPercent" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                   FontSize="13.5" Foreground="{StaticResource ColorBrushGray3}" Text="0%" />
                    </Grid>

                    <!-- 底部操作：连接中是"取消"，失败时是"重试 / 返回" -->
                    <Grid x:Name="PanLoadActions" Grid.Row="5" Margin="0,26,0,0">
                        <local:MyButton x:Name="BtnLoadCancel" Text="取消" Padding="28,9" MinWidth="120" HorizontalAlignment="Right" />
                        <StackPanel x:Name="PanLoadRetryGroup" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                            <local:MyButton x:Name="BtnLoadRetry" Text="重试" Padding="28,9" MinWidth="120" Margin="0,0,12,0" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnLoadBack" Text="返回" Padding="28,9" MinWidth="120" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ③ 已连接 -->
                <Grid x:Name="PanDone" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="13" Background="{StaticResource BrushAccentSoft}" VerticalAlignment="Center">
                            <Path Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  x:Name="ImgFinishLogo" Fill="{DynamicResource ColorBrush3}" RenderTransformOrigin="0.5,0.54"
                                  Data="M845 547.45h65.54A400.6 400.6 0 0 0 712.7 201.77l-33.22 56.49C781.6 318.32 845 429.13 845 547.45zM347.72 253.92L316 196.58a401.21 401.21 0 0 0-207 350.87h65.54a335.66 335.66 0 0 1 173.18-293.53zM509.79 882.68a334 334 0 0 1-181.3-53.2L293 884.57a401.13 401.13 0 0 0 419.1 8.91L679 836.93a334.94 334.94 0 0 1-169.21 45.75z M821.51 625.1A108.64 108.64 0 0 0 752.2 650l-67.31-38.86a185.44 185.44 0 0 0 11.22-63.7c0-91.55-66.38-167.9-153.54-183.42V289a109.14 109.14 0 1 0-65.57 0v75c-87.16 15.53-153.54 91.87-153.54 183.42a185.46 185.46 0 0 0 11.22 63.7L267.39 650a109.17 109.17 0 1 0 35.81 55l64.47-37.23a186 186 0 0 0 284.23 0L716.38 705a109.13 109.13 0 1 0 105.13-79.9zM198.07 777.85a43.6 43.6 0 1 1 43.61-43.61 43.66 43.66 0 0 1-43.61 43.61z m311.72-636.53a43.61 43.61 0 1 1-43.61 43.61 43.65 43.65 0 0 1 43.61-43.61z m0 526.91a120.78 120.78 0 1 1 120.78-120.78 120.91 120.91 0 0 1-120.78 120.77z m311.72 109.62a43.6 43.6 0 1 1 43.61-43.61 43.65 43.65 0 0 1-43.61 43.61z" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,10,0">
                            <TextBlock x:Name="LabFinishTitle" Text="已加入房间" FontSize="19" Foreground="{StaticResource ColorBrush1}" />
                            <TextBlock x:Name="LabFinishDesc" Text="" FontSize="12.5" Margin="0,4,0,0" Foreground="{StaticResource ColorBrushGray4}" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{StaticResource ColorBrushSemiTransparent}" CornerRadius="9" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock x:Name="LabFinishPlayer" Text="2 人" FontSize="12.5" Foreground="{StaticResource ColorBrushGray2}" />
                        </Border>
                    </Grid>

                    <Border x:Name="PanFinishCode" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed"
                            Background="{StaticResource ColorBrushSemiTransparent}" CornerRadius="12" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="邀请码" FontSize="12" Foreground="{StaticResource ColorBrushGray4}" />
                                <TextBlock x:Name="LabFinishCode" Text="U/XXXX-XXXX-XXXX-XXXX" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush3}" Margin="0,6,0,0" />
                            </StackPanel>
                            <local:MyButton Grid.Column="1" x:Name="BtnFinishCopy" Text="复制邀请码" Padding="20,9" MinWidth="118" VerticalAlignment="Center" ColorType="Highlight" />
                        </Grid>
                    </Border>

                    <Border x:Name="PanFinishHall" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed"
                            Background="{StaticResource ColorBrushSemiTransparent}" CornerRadius="12" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="服务器地址" FontSize="12" Foreground="{StaticResource ColorBrushGray4}" />
                                <TextBlock x:Name="LabFinishIp" Text="6.0.0.1:12345" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource ColorBrush1}" Margin="0,6,0,0" />
                            </StackPanel>
                            <local:MyButton Grid.Column="1" x:Name="BtnFinishIp" Text="复制地址" Padding="20,9" MinWidth="110" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <local:MyHint x:Name="HintFinish" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed" Text="" Theme="Blue" />

                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <local:MyButton x:Name="BtnFinishExit" Text="退出" Padding="26,9" MinWidth="118" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>
        </local:MyCard>

        <Grid x:Name="PanAlways" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="15" Opacity="0.5">
            <local:MyTextButton x:Name="BtnFooter" Text="联机由 陶瓦联机（Terracotta）提供支持" Opacity="0.4" ToolTip="查看陶瓦联机文档" />
        </Grid>
    </Grid>
</local:MyPageRight>
