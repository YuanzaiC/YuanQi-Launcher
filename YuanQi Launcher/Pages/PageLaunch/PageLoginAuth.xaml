<Grid x:Class="PageLoginAuth" Tag="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YuanQi"
      mc:Ignorable="d" d:DesignWidth="317.6" Margin="0,0,0,-2">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Text="邮箱" Style="{StaticResource FieldLabel}" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,16,0" />
    <local:MyComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" Height="30" x:Name="ComboName" />

    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,16,0" />
    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="TextPass" Height="30" />

    <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,2,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:MyCheckBox x:Name="CheckRemember" Tag="LoginRemember" Height="20" Text="记住密码" Grid.Column="0" />
        <local:MyTextButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="BtnLink" Content="注册账号"
                            Foreground="{DynamicResource ColorBrush2}" FontSize="12.5" Padding="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" />
    </Grid>
</Grid>
