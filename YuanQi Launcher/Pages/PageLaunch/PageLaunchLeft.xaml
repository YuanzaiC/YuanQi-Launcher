<local:MyPageLeft x:Class="PageLaunchLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YuanQi"
             mc:Ignorable="d" x:Name="PanBack"
             d:DesignHeight="760">
    <local:MyPageLeft.Resources>
        <!-- 主页日历格子：悬浮 / 选中都只用同一圈描边（绝不替换背景，否则会把热度色块盖成灰白色）。
             选中状态通过 Tag（sel / sel-dark）切换，保证悬浮与选中不会叠出两层框。 -->
        <Style x:Key="CalDayCell" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                            <Border x:Name="Ring" CornerRadius="6" IsHitTestVisible="False"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 悬浮：一圈主题色细描边 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderThickness" Value="1.4" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
                            </Trigger>
                            <!-- 选中：加粗的同色圈（放在后面，优先于悬浮态） -->
                            <Trigger Property="Tag" Value="sel">
                                <Setter TargetName="Ring" Property="BorderThickness" Value="1.8" />
                            </Trigger>
                            <Trigger Property="Tag" Value="sel-dark">
                                <Setter TargetName="Ring" Property="BorderThickness" Value="1.8" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主页专用：Hero 次级操作组（分段控件内的图标 + 文字段） -->
        <Style x:Key="BtnSegment" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 悬停高亮以内嵌圆角块呈现，避免溢出外层胶囊的圆角 -->
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 账户胶囊：圆角胶囊按钮，点击展开账号下拉 -->
        <Style x:Key="AccountCapsule" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource BrushSurface2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <Border x:Name="Hl" Background="#000000" CornerRadius="8" IsHitTestVisible="False" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity">
                                            <DoubleAnimation To="0.035" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard Storyboard.TargetName="Hl" Storyboard.TargetProperty="Opacity">
                                            <DoubleAnimation To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 洞察统计行的小图标底 -->
        <Style x:Key="InsightIcon" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource BrushAccentSoft2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Mica 质感分段按钮：半透明纵向渐变 + 细描边，悬停/按下以覆盖层反馈 -->
        <Style x:Key="BtnSegmentMica" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C2FFFFFF" Offset="0" />
                        <GradientStop Color="#99EFF5E8" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#3E8A9B84"
                                    BorderThickness="1" CornerRadius="7" />
                            <Border x:Name="Hl" Background="{DynamicResource BrushHover}" CornerRadius="7"
                                    Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Background" Value="{DynamicResource BrushPressed}" />
                                <Setter TargetName="Hl" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:MyPageLeft.Resources>
    <!-- ==================== 主页：问候 + 左内容列（实例 / 存档 / 最近游玩）+ 右侧栏（账户 / 日历 / 洞察）+ 发现 ==================== -->
    <Grid Name="PanInput" Background="Transparent">
        <Grid.RenderTransform>
            <ScaleTransform />
        </Grid.RenderTransform>
        <local:MyScrollViewer x:Name="PanHomeScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,14,20,16">

                <!-- 问候行 -->
                <Grid Margin="2,2,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LabGreetingTitle" Text="你好" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" />
                        <TextBlock x:Name="LabGreetingSub" Text="" FontSize="12" Foreground="{DynamicResource BrushText3}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="BtnStatusFolder" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BtnSmall}" ToolTip="打开实例或启动器所在目录">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,3.5 h4.6 l1.4 1.8 H15 v7.2 H1 Z" Stroke="{DynamicResource BrushText1}" StrokeThickness="1.3" Fill="Transparent"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="打开目录" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 主双栏：左内容列 + 右侧栏 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="400" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="308" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ 左内容列 ============ -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <!-- Hero：当前实例（主题色描边 + 主题色深投影 + 淡主题底，凸显启动主模块） -->
                        <Border Grid.Row="0" x:Name="PanHero" VerticalAlignment="Top" Style="{StaticResource Card}" Padding="22,16,22,16" Margin="0,0,0,12"
                                BorderBrush="{DynamicResource ColorBrush5}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.2" Color="{DynamicResource ColorObject2}" RenderingBias="Performance" />
                            </Border.Effect>
                                        <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 全卡淡绿底（随主题色联动）：让 Hero 与其余纯白卡片明显区分 -->
                                    <Rectangle x:Name="RectHeroTint" Grid.Row="0" Grid.RowSpan="4" Margin="-22,-16,-22,-16" RadiusX="8" RadiusY="8" IsHitTestVisible="False"
                                               Fill="{DynamicResource ColorBrush6}" Opacity="0.35" />
                                    <!-- 悬停径向光晕：鼠标进入时淡入，中心偏向启动按钮（不参与布局） -->
                                    <Rectangle x:Name="RectHeroGlow" Grid.Row="0" Grid.RowSpan="4" Margin="-22,-16,-22,-16" RadiusX="8" RadiusY="8" IsHitTestVisible="False" Opacity="0">
                                        <Rectangle.Fill>
                                            <RadialGradientBrush GradientOrigin="0.22,0.62" Center="0.22,0.62" RadiusX="0.6" RadiusY="0.95">
                                                        <GradientStop Color="{DynamicResource ColorObject5}" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </RadialGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <!-- 环境信息行：左侧标签 + 右侧环境胶囊 -->
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="当前实例" FontSize="11.5" Foreground="{DynamicResource BrushText3}" VerticalAlignment="Center" />
                                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border x:Name="PanChipInstance" Style="{StaticResource ChipAccent}" Margin="0,0,8,4">
                                                <TextBlock x:Name="LabChipInstance" Text="未选择版本" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PanChipVersion" Style="{StaticResource Chip}" Margin="0,0,8,4">
                                                <TextBlock x:Name="LabChipVersion" Text="—" FontSize="11.5" Foreground="{DynamicResource BrushText2}"
                                                           VerticalAlignment="Center" FontFamily="Consolas, Microsoft YaHei UI" />
                                            </Border>
                                            <Border x:Name="PanChipLoader" Style="{StaticResource Chip}" Margin="0,0,8,4" Visibility="Collapsed">
                                                <TextBlock x:Name="LabChipLoader" Text="" FontSize="11.5" Foreground="{DynamicResource BrushText2}" VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PanChipJava" Style="{StaticResource Chip}" Margin="0,0,8,4">
                                                <TextBlock x:Name="LabChipJava" Text="Java —" FontSize="11.5" Foreground="{DynamicResource BrushText2}"
                                                           VerticalAlignment="Center" FontFamily="Consolas, Microsoft YaHei UI" />
                                            </Border>
                                            <Border x:Name="PanChipRam" Style="{StaticResource Chip}" Margin="0,0,0,4">
                                                <TextBlock x:Name="LabChipRam" Text="内存 —" FontSize="11.5" Foreground="{DynamicResource BrushText2}"
                                                           VerticalAlignment="Center" FontFamily="Consolas, Microsoft YaHei UI" />
                                            </Border>
                                        </WrapPanel>
                                    </Grid>

                                    <!-- 实例身份：图标 + 名称 / 描述 -->
                                    <Grid Grid.Row="1" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="54" Height="54" CornerRadius="12" BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1" Background="{DynamicResource BrushSurface2}" ClipToBounds="True" VerticalAlignment="Center">
                                            <local:MyImage x:Name="ImgInstanceLogo" Source="pack://application:,,,/images/SplashIcon.png" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LabInstanceName" Text="加载中…" Style="{StaticResource TitleDisplay}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="LabInstanceMeta" Text="" FontSize="13" Foreground="{DynamicResource BrushText2}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 启动行：主操作 + 上次游玩 -->
                                    <Grid Grid.Row="2" Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="AprilScaleTrans" />
                                                    <TranslateTransform x:Name="AprilPosTrans" />
                                                </TransformGroup>
                                            </Grid.RenderTransform>
                                            <!-- 启动按钮：主页唯一主操作（更大尺寸 + 深投影；悬停上浮与阴影变化由代码驱动）
                                                 投影半径刻意控制在 20 以内：分层窗口只能软件渲染，
                                                 模糊半径每涨一档、每帧重绘的开销都会成倍上涨。 -->
                                            <Border HorizontalAlignment="Left" x:Name="HeroBtnBorder" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="HeroBtnTrans" Y="0" />
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="HeroBtnShadow" Color="#26200F0A" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="1" RenderingBias="Performance" />
                                                </Border.Effect>
                                                <local:MyButton x:Name="BtnLaunch" Height="60" MinWidth="284" Text="正在加载" ColorType="Highlight"
                                                                ForceWhiteText="True" AccentShadow="True" IsEnabled="False" TextPadding="12,0,0,0" TextFontSize="17" TextFontWeight="Bold"
                                                                Logo="M6.8,4.4 L15.4,10 L6.8,15.6 Z" LogoScale="0.92" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="2" Margin="20,2,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LabPlayNoteTitle" Text="上次游玩" FontSize="11.5" Foreground="{DynamicResource BrushText3}" />
                                            <TextBlock x:Name="LabPlayNote" Text="—" FontSize="12.5" Foreground="{DynamicResource BrushText2}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <TextBlock x:Name="LabPlayNoteRam" Text="" FontSize="12" Foreground="{DynamicResource BrushText3}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 次级操作组：三枚独立 Mica 按钮 -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,18,0,0">
                                        <Button x:Name="BtnVersion" Style="{StaticResource BtnSegmentMica}" ToolTip="选择或安装游戏版本" IsEnabled="False">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M0,2 h14 v2 h-14 Z M0,6 h8.5 v2 h-8.5 Z M0,10 h11.5 v2 h-11.5 Z" Fill="{DynamicResource BrushText2}"
                                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="版本选择" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnMore" Visibility="Collapsed" Style="{StaticResource BtnSegmentMica}" Margin="8,0,0,0" ToolTip="版本设置">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M3,6.5 h6 M13.5,6.5 h3.5 M3,13.5 h3.5 M11,4.5 a2,2 0 1 1 0,4 a2,2 0 1 1 0,-4 Z M6.5,11.5 a2,2 0 1 1 0,4 a2,2 0 1 1 0,-4 Z"
                                                      Stroke="{DynamicResource BrushText2}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="版本设置" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="BtnInstanceFolder" Style="{StaticResource BtnSegmentMica}" Margin="8,0,0,0" ToolTip="打开实例所在文件夹">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M1,3.5 h4.6 l1.4 1.8 H15 v7.2 H1 Z" Stroke="{DynamicResource BrushText2}" StrokeThickness="1.3" Fill="Transparent"
                                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="打开目录" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                        </Border>

                        <!-- 存档 -->
                        <Border Grid.Row="1" x:Name="PanSavesCard" Style="{StaticResource CardFlat}" Padding="14,12,14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="2,0,2,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="存档" Style="{StaticResource CardTitle}" />
                                        <TextBlock x:Name="LabSavesCount" Style="{StaticResource MutedText}" Margin="8,3,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button x:Name="BtnSavesRefresh" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource BtnGhost}" Height="24" Padding="8,0" FontSize="11.5" Content="刷新" />
                                </Grid>
                                <!-- 固定最大高度 + 内部滚动：卡片高度不随存档数量撑爆 -->
                                <!-- 最多显示 3 条，其余在列表内部用滚轮滚动，卡片高度稳定 -->
                                <Grid Margin="6,0,6,4" x:Name="PanSaves" MinHeight="24">
                                    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                          x:Name="PanSavesScroll" MaxHeight="120" MinHeight="120" DeltaMult="0.7">
                                        <StackPanel x:Name="PanSavesList" />
                                    </local:MyScrollViewer>
                                </Grid>
                                <Button x:Name="BtnWorldFolder" Margin="6,0,0,4" HorizontalAlignment="Left" Style="{StaticResource BtnGhost}"
                                        Height="24" Padding="6,0" FontSize="11.5" Content="打开存档文件夹 ›" />
                            </StackPanel>
                        </Border>

                        <!-- 最近游玩 -->
                        <Border Grid.Row="2" x:Name="PanRecentCard" Style="{StaticResource CardFlat}" Padding="14,12,14,10">
                            <StackPanel>
                                <Grid Margin="2,0,2,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="最近游玩" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="点击切换实例" Style="{StaticResource MutedText}" Margin="8,3,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="PanRecentPlay" Margin="2,0,2,2" />
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- ============ 右侧栏 ============ -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                            <!-- 账户 -->
                            <Border Grid.Row="0" x:Name="PanAccountCard" Style="{StaticResource CardFlat}" Padding="12,12,12,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- 账户胶囊：点击展开账号下拉 -->
                                    <Button x:Name="BtnAccount" Style="{StaticResource AccountCapsule}" HorizontalContentAlignment="Stretch" ToolTip="切换或管理账号">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:MySkinHead x:Name="SkinHeadAccount" Width="34" Height="34" CornerRadius="8" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="LabAccountName" Text="未登录" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="LabAccountType" Text="Minecraft 账户" FontSize="11" Foreground="{DynamicResource BrushText3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Path x:Name="PathAccountArrow" Grid.Column="2" Data="M1,1 L4.5,4.5 L8,1" Stroke="{DynamicResource BrushText3}" StrokeThickness="1.5"
                                                  Width="10" Height="6" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="AccountArrowRotate" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Button>

