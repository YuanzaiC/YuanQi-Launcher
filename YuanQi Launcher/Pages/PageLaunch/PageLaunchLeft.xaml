                            <Button x:Name="BtnGoOreGuide" Style="{StaticResource BtnSmall}" Margin="0,0,8,0" ToolTip="查看矿石分布">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6.2,1.6 C8.4,1.6 10.4,2.7 11.7,4.6 L8.2,8.1 L3.2,3.1 C4,2.1 5,1.6 6.2,1.6 Z M2.4,3.9 L7.4,8.9 L4.2,12.1 C2.7,10.9 1.8,9.2 1.8,7.4 C1.8,6.2 2,3.5 2.4,3.9 Z M8.9,9.6 L12.4,6.1 C12.8,7 13,7.8 13,8.7 C13,10 12.5,11.3 11.8,12.3 Z"
                                          Stroke="{DynamicResource BrushText1}" StrokeThickness="1.2" Fill="Transparent"
                                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="矿石分布" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnGoColorText" Style="{StaticResource BtnSmall}" ToolTip="打开彩色文字生成器">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2.5,13.5 L8.5,2.5 L14.5,13.5 M4.8,9.5 h7.4" Stroke="{DynamicResource BrushText1}" StrokeThickness="1.4" Fill="Transparent"
                                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="彩色文字" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </local:MyScrollViewer>
    </Grid>

    <!-- ==================== 启动中覆盖层 ==================== -->
    <Grid Name="PanLaunching" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" Opacity="0" Background="#F3F3F3">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" RenderTransformOrigin="0.5,0.5" Margin="0,-7,0,0" HorizontalAlignment="Center">
            <local:MyLoading x:Name="LoadLaunching" AutoRun="False" Height="50" Margin="0,10,0,5" HorizontalAlignment="Center" />
            <TextBlock Name="LabLaunchingTitle" Margin="15,10,15,0" Text="正在启动游戏" HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource BrushText1}">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Name="LabLaunchingName" Margin="40,5,40,0" FontSize="13.5" Text="" HorizontalAlignment="Center" Foreground="{DynamicResource BrushText2}" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <Grid Height="4" Width="380" Margin="30,12,30,27" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="ProgressLaunchingFinished" Width="0*"/>
                    <ColumnDefinition Name="ProgressLaunchingUnfinished" Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource ColorBrush3}" CornerRadius="2" />
                <Border Grid.Column="1" Background="#ECECEC" CornerRadius="2" />
            </Grid>
            <Grid HorizontalAlignment="Center" Name="PanLaunchingInfo">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="当前步骤" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource BrushText3}" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingStage" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="登录方式" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource BrushText3}" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingMethod" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="启动进度" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Name="LabLaunchingProgressLeft" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="0.00 %" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingProgress" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="下载速度" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Name="LabLaunchingDownloadLeft" Visibility="Collapsed" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="0 B/s" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingDownload" Opacity="0" Visibility="Collapsed" />
                <Grid x:Name="PanLaunchingHint" HorizontalAlignment="Center" Grid.Row="2" Grid.ColumnSpan="5" Grid.RowSpan="2" Width="320" Margin="0,16,0,2" Visibility="Collapsed" Opacity="0">
                    <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="3" BorderBrush="{StaticResource ColorBrushGray1}" Opacity="0.25" />
                    <TextBlock FontSize="12.5" Text="你知道吗" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{StaticResource ColorBrushGray1}" Opacity="0.5" />
                    <TextBlock x:Name="LabLaunchingHint" FontSize="12.5" Text="这是一段测试用的小提示文本，它应该足够长以让它有两行。" Margin="11,21,11,10" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{DynamicResource BrushText2}" />
                </Grid>
            </Grid>
        </StackPanel>
        <Button Grid.Row="4" x:Name="BtnCancel" Height="34" Width="200" Margin="20,0,20,20" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Style="{StaticResource BtnBase}" Content="取消" />
    </Grid>
</local:MyPageLeft>
