<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSaveSetup"
    PanScroll="PanBack">
    <local:MyPageRight.Resources>
        <!-- 分段导航 · 未选中 -->
        <Style x:Key="NavTab" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 分段导航 · 选中 -->
        <Style x:Key="NavTabSel" TargetType="Button" BasedOn="{StaticResource NavTab}">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.08" Color="#000000" RenderingBias="Performance" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurface}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 分组标题 -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText1}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 事实块 -->
        <Style x:Key="FactTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface2}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="FactLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText3}" />
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText1}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </local:MyPageRight.Resources>
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="24,22,24,26">

            <!-- ① Hero 头部（常驻） -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid Margin="20,20,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnCover" Style="{StaticResource BtnGhost}" Width="80" Height="80" Padding="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="点击放大 / 还原封面">
                        <Border x:Name="PanCover" Width="72" Height="72" CornerRadius="16" ClipToBounds="True" Background="{DynamicResource BrushSurface2}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <local:MyImage x:Name="ImgIcon" Stretch="UniformToFill" />
                        </Border>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LabName" Text="加载中…" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" MaxWidth="460" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="LabWorldName" Text="—" FontSize="13" Foreground="{DynamicResource BrushText2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text=" · " FontSize="13" Foreground="{DynamicResource BrushText3}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabVersion" Text="—" FontSize="13" Foreground="{DynamicResource BrushText3}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnLaunch" Style="{StaticResource BtnPrimary}" Content="启动此世界" Height="40" />
                        <Button x:Name="BtnBackup" Style="{StaticResource BtnBase}" Content="备份" Height="40" Margin="10,0,0,0" />
                        <Button x:Name="BtnMore" Style="{StaticResource BtnBase}" Content="⋯" Height="40" Width="40" Padding="0" Margin="10,0,0,0">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <local:MyMenuItem Header="更改封面" Click="MenuChangeCover_Click" />
                                    <local:MyMenuItem Header="重命名存档" Click="MenuRename_Click" />
                                    <local:MyMenuItem Header="打开存档目录" Click="MenuOpenFolder_Click" />
                                    <local:MyMenuItem Header="导出存档" Click="MenuExport_Click" />
                                    <local:MyMenuItem Header="删除存档（移至回收站）" Foreground="{DynamicResource BrushDanger}" Click="MenuDelete_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ② 分段导航（常驻） -->
            <Border Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,16" SnapsToDevicePixels="True">
                <UniformGrid Rows="1">
                    <Button x:Name="BtnTab0" Style="{StaticResource NavTabSel}" Content="概览" />
                    <Button x:Name="BtnTab1" Style="{StaticResource NavTab}" Content="世界" />
                    <Button x:Name="BtnTab2" Style="{StaticResource NavTab}" Content="玩家" />
                    <Button x:Name="BtnTab3" Style="{StaticResource NavTab}" Content="物品" />
                    <Button x:Name="BtnTab4" Style="{StaticResource NavTab}" Content="备份" />
                    <Button x:Name="BtnTab5" Style="{StaticResource NavTab}" Content="数据" />
                </UniformGrid>
            </Border>

            <!-- ③ 内容区 -->
            <Grid>
                <!-- 概览 -->
                <Border x:Name="PanOverview" Style="{StaticResource Card}">
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock Text="概览" Style="{StaticResource GroupTitle}" />
                        <TextBlock Text="存档的只读信息" Style="{StaticResource MutedText}" Margin="0,2,0,14" />
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource FactTile}">
                                <StackPanel>
                                    <TextBlock Text="世界种子" Style="{StaticResource FactLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="LabSeed" Text="—" Style="{StaticResource FactValue}" FontFamily="Consolas, Microsoft YaHei UI" VerticalAlignment="Center" />
                                        <Button x:Name="BtnCopySeed" Style="{StaticResource BtnSmall}" Content="复制" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Button x:Name="BtnSeedMap" Style="{StaticResource BtnSmall}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="在种子地图中打开这个世界（带上种子与版本）">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M1,3.2 L5,1.8 L9,3.2 L13,1.8 V12.2 L9,13.6 L5,12.2 L1,13.6 Z M5,1.8 V12.2 M9,3.2 V13.6"
                                                      Stroke="{DynamicResource BrushText1}" StrokeThickness="1.2" Fill="Transparent"
                                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="地图" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactTile}">
                                <StackPanel>
                                    <TextBlock Text="游戏版本" Style="{StaticResource FactLabel}" />
                                    <TextBlock x:Name="LabVersionFact" Text="—" Style="{StaticResource FactValue}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactTile}">
                                <StackPanel>
                                    <TextBlock Text="上次游玩" Style="{StaticResource FactLabel}" />
                                    <TextBlock x:Name="LabLastPlayed" Text="—" Style="{StaticResource FactValue}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactTile}">
                                <StackPanel>
                                    <TextBlock Text="存档大小" Style="{StaticResource FactLabel}" />
                                    <TextBlock x:Name="LabSize" Text="—" Style="{StaticResource FactValue}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactTile}">
                                <StackPanel>
                                    <TextBlock Text="玩家名称" Style="{StaticResource FactLabel}" />
                                    <TextBlock x:Name="LabPlayerNameFact" Text="—" Style="{StaticResource FactValue}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactTile}">
                                <StackPanel>
                                    <TextBlock Text="所在维度" Style="{StaticResource FactLabel}" />
                                    <TextBlock x:Name="LabDimensionFact" Text="—" Style="{StaticResource FactValue}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource FactTile}" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="所在目录" Style="{StaticResource FactLabel}" />
                                    <TextBlock x:Name="LabPath" Text="—" Style="{StaticResource FactValue}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="BtnOpenFolder" Grid.Column="1" Style="{StaticResource BtnSmall}" Content="打开" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 世界 -->
                <Border x:Name="PanWorld" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Margin="20,18,20,20">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="世界设置" Style="{StaticResource GroupTitle}" />
                                <TextBlock Text="世界名、模式、难度、规则等在同一处查看并修改" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="BtnApplySettings" Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="保存世界设置" Height="40" VerticalAlignment="Top" />
                        </Grid>

                        <TextBlock Text="基本" Style="{StaticResource FieldLabel}" Margin="0,10,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="世界名称" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyTextBox x:Name="TextLevelName" HintText="世界显示名称（不是文件夹名）" MaxLength="64" Height="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="游戏模式" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyComboBox x:Name="ComboGameType" Height="36">
                                    <local:MyComboBoxItem Content="生存" />
                                    <local:MyComboBoxItem Content="创造" />
                                    <local:MyComboBoxItem Content="冒险" />
                                    <local:MyComboBoxItem Content="旁观" />
                                </local:MyComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="难度" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyComboBox x:Name="ComboDifficulty" Height="36">
                                    <local:MyComboBoxItem Content="和平" />
                                    <local:MyComboBoxItem Content="简单" />
                                    <local:MyComboBoxItem Content="普通" />
                                    <local:MyComboBoxItem Content="困难" />
                                </local:MyComboBox>
                            </StackPanel>
                        </Grid>
                        <local:MyCheckBox x:Name="CheckCheats" Height="24" Text="允许作弊" Margin="0,12,0,0" />

                        <TextBlock Text="常用游戏规则" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                        <UniformGrid Columns="2">
                            <local:MyCheckBox x:Name="CheckRuleKeepInventory" Height="24" Text="死亡不掉落（keepInventory）" />
                            <local:MyCheckBox x:Name="CheckRuleDaylight" Height="24" Text="昼夜循环（doDaylightCycle）" />
                            <local:MyCheckBox x:Name="CheckRuleMobGrief" Height="24" Text="生物破坏（mobGriefing）" />
                            <local:MyCheckBox x:Name="CheckRuleFireTick" Height="24" Text="火焰蔓延（doFireTick）" />
                            <local:MyCheckBox x:Name="CheckRuleWeather" Height="24" Text="天气循环（doWeatherCycle）" />
                        </UniformGrid>

                        <TextBlock Text="世界状态" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="出生点 X" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyTextBox x:Name="TextSpawnX" HintText="X" Height="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="出生点 Y" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyTextBox x:Name="TextSpawnY" HintText="Y" Height="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="出生点 Z" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyTextBox x:Name="TextSpawnZ" HintText="Z" Height="36" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="世界时间" Style="{StaticResource FactLabel}" Margin="0,12,0,4" />
                        <local:MyTextBox x:Name="TextTime" HintText="游戏内刻（tick），1200 为清晨" Height="36" MaxWidth="360" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- 玩家 -->
                <Border x:Name="PanPlayer" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock Text="玩家数据" Style="{StaticResource GroupTitle}" />
                        <TextBlock Text="选择要查看 / 修改的玩家，写入前会自动备份" Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                        <TextBlock Text="选择玩家" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                        <local:MyComboBox x:Name="ComboPlayer" Height="36" MinWidth="220" MaxWidth="360" HorizontalAlignment="Left" />
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <Border Style="{StaticResource FactTile}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="玩家名称" Style="{StaticResource FactLabel}" />
                                    <TextBlock x:Name="LabPlayerName2" Text="—" Style="{StaticResource FactValue}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FactTile}" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="所在维度" Style="{StaticResource FactLabel}" />
                                    <TextBlock x:Name="LabDimension2" Text="—" Style="{StaticResource FactValue}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="坐标与经验" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="X 坐标" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyTextBox x:Name="TextPlayerX" HintText="X 坐标" Height="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y 坐标" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyTextBox x:Name="TextPlayerY" HintText="Y 坐标" Height="36" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Z 坐标" Style="{StaticResource FactLabel}" Margin="0,0,0,4" />
                                <local:MyTextBox x:Name="TextPlayerZ" HintText="Z 坐标" Height="36" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="经验等级" Style="{StaticResource FactLabel}" Margin="0,12,0,4" />
                        <local:MyTextBox x:Name="TextPlayerXp" HintText="经验等级" Height="36" MaxWidth="360" HorizontalAlignment="Left" />
                        <Button x:Name="BtnApplyPlayer" Style="{StaticResource BtnPrimary}" Content="应用玩家修改" HorizontalAlignment="Right" Height="40" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>

                <!-- 物品 -->
                <Border x:Name="PanInventory" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Margin="20,18,20,20">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="物品" Style="{StaticResource GroupTitle}" />
                                <TextBlock Text="背包与末影箱的物品管理" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnInvInventory" Style="{StaticResource NavTabSel}" Content="背包" Height="36" MinWidth="80" />
                                <Button x:Name="BtnInvEnder" Style="{StaticResource NavTab}" Content="末影箱" Height="36" MinWidth="80" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <local:MyScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PanInvList" />
                        </local:MyScrollViewer>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TextAddItemId" Grid.Column="0" HintText="物品 ID（如 minecraft:diamond）" />
                            <local:MyTextBox x:Name="TextAddItemCount" Grid.Column="2" HintText="数量" />
                            <Button x:Name="BtnAddItem" Grid.Column="4" Style="{StaticResource BtnBase}" Content="添加" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 备份 -->
                <Border x:Name="PanSnapshot" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock Text="备份与恢复" Style="{StaticResource GroupTitle}" />
                        <TextBlock Text="创建、恢复与管理存档备份" Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnCreateBackup" Style="{StaticResource BtnPrimary}" Content="创建备份" Height="40" />
                            <Button x:Name="BtnImport" Style="{StaticResource BtnBase}" Content="导入存档" Height="40" Margin="8,0,0,0" />
                            <Button x:Name="BtnExport" Style="{StaticResource BtnBase}" Content="导出存档" Height="40" Margin="8,0,0,0" />
                            <Button x:Name="BtnCopy" Style="{StaticResource BtnBase}" Content="创建副本" Height="40" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="保留备份数量" Style="{StaticResource FactLabel}" Margin="0,14,0,4" />
                        <local:MyTextBox x:Name="TextBackupCount" HintText="例如 10（自动清理更早的备份）" Height="36" MaxWidth="360" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LabBackupTitle" Text="备份历史" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                        <StackPanel x:Name="PanBackupList" />
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <Border x:Name="PanData" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock Text="数据" Style="{StaticResource GroupTitle}" />
                        <TextBlock Text="统计、进度与 NBT 只读查看" Style="{StaticResource MutedText}" Margin="0,2,0,12" />

                        <Grid>
                            <TextBlock Text="NBT 数据（只读）" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Button x:Name="BtnToggleNbt" HorizontalAlignment="Right" Style="{StaticResource BtnGhost}" Content="展开" />
                        </Grid>
                        <StackPanel x:Name="PanNbt" Visibility="Collapsed" Margin="0,10,0,0" />

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="统计" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Button x:Name="BtnToggleStats" HorizontalAlignment="Right" Style="{StaticResource BtnGhost}" Content="展开" />
                        </Grid>
                        <StackPanel x:Name="PanStatsBody" Visibility="Collapsed" Margin="0,8,0,0">
                            <Button x:Name="BtnClearStats" Style="{StaticResource BtnDanger}" Content="清空统计" Height="28" HorizontalAlignment="Right" />
                            <local:MyScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                                <StackPanel x:Name="PanStatsList" />
                            </local:MyScrollViewer>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="进度" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <Button x:Name="BtnToggleAdv" HorizontalAlignment="Right" Style="{StaticResource BtnGhost}" Content="展开" />
                        </Grid>
                        <StackPanel x:Name="PanAdvBody" Visibility="Collapsed" Margin="0,8,0,0">
                            <Button x:Name="BtnClearAdv" Style="{StaticResource BtnDanger}" Content="重置进度" Height="28" HorizontalAlignment="Right" />
                            <local:MyScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                                <StackPanel x:Name="PanAdvList" />
                            </local:MyScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
