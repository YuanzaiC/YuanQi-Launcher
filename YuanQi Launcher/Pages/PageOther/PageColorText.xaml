<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageColorText"
    PanScroll="PanBack">
    <local:MyPageRight.Resources>
        <!-- 分段切换按钮（场景 / 输出格式） -->
        <Style x:Key="SegRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="11,4" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurface}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 颜色 / 渐变色块 -->
        <Style x:Key="SwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#88000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:MyPageRight.Resources>
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="24,22,24,26">

            <!-- 页头 -->
            <Grid x:Name="PanHeader" Margin="2,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="彩色文字" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="生成器" Style="{StaticResource PageSub}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" x:Name="DotHeadCount" Fill="{DynamicResource ColorBrush3}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LabHeadCount" Text="实际字符 0 / 256" FontSize="11.5" Foreground="{DynamicResource BrushText2}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnCopyHeader" Style="{StaticResource BtnPrimary}" Content="复制输出" Padding="16,0" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <!-- ============ 左栏 · 编辑 ============ -->
                <StackPanel Grid.Column="0" x:Name="PanColLeft" Margin="0,0,6,0">

                    <!-- 文字输入 -->
                    <Border Style="{StaticResource Card}" Padding="16,13,16,13" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="文字输入" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="作用于选中文字，或插入到光标处" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <local:MyTextBox x:Name="TextColorInput" HintText="输入文字，或点击「插入示例」快速体验" Height="84"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" />
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="LabStats" Text="实际字符 0 / 256 · 含格式码 0" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnColorUndo" Style="{StaticResource BtnSmall}" Content="撤销" Width="54" Margin="0,0,6,0" IsEnabled="False" />
                                    <Button x:Name="BtnColorRedo" Style="{StaticResource BtnSmall}" Content="重做" Width="54" Margin="0,0,6,0" IsEnabled="False" />
                                    <Button x:Name="BtnColorReset" Style="{StaticResource BtnSmall}" Content="重置样式" Margin="0,0,6,0" />
                                    <Button x:Name="BtnColorClear" Style="{StaticResource BtnSmall}" Content="清空" Width="54" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 文字样式 -->
                    <Border Style="{StaticResource Card}" Padding="16,13,16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="文字样式" Style="{StaticResource CardTitle}" Margin="0,0,0,9" />
                            <WrapPanel>
                                <Button x:Name="BtnStyleBold" Style="{StaticResource BtnGhost}" Height="32" Padding="11,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="B" FontWeight="ExtraBold" FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="粗体" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStyleItalic" Style="{StaticResource BtnGhost}" Height="32" Padding="11,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontWeight="SemiBold" FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="斜体" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStyleUnderline" Style="{StaticResource BtnGhost}" Height="32" Padding="11,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="U" TextDecorations="Underline" FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="下划线" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStyleStrike" Style="{StaticResource BtnGhost}" Height="32" Padding="11,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="删除线" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStyleObf" Style="{StaticResource BtnGhost}" Height="32" Padding="11,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌁" FontSize="14" Margin="0,0,7,0" />
                                        <TextBlock Text="混淆" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 颜色 -->
                    <Border Style="{StaticResource Card}" Padding="16,13,16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="颜色" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="LabColorName" Text="经典 16 色" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <WrapPanel x:Name="PanClassicColors" Margin="0,0,-6,-6" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="自定义" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                <local:MyTextBox x:Name="TextHexInput" Width="118" HintText="#RRGGBB" FontSize="12.5" FontFamily="Consolas, Microsoft YaHei UI" Height="30" />
                                <Button x:Name="BtnPickColor" Style="{StaticResource BtnBase}" Content="取色器" Height="30" Padding="11,0" Margin="8,0,0,0" />
                                <TextBlock Text="输入后回车应用" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 渐变 -->
                    <Border Style="{StaticResource Card}" Padding="16,13,16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="渐变" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="逐字插值为 §x 彩色码" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnGradStart" Style="{StaticResource SwatchBtn}" Margin="0,0,8,0" Background="#FFD278" ToolTip="起始颜色" />
                                <TextBlock Grid.Column="1" Text="→" FontSize="13" Foreground="{DynamicResource BrushText3}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border x:Name="BdGradBar" Grid.Column="2" Height="28" CornerRadius="6" BorderThickness="1" BorderBrush="#22000000" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop x:Name="GradStopA" Color="#FFD278" Offset="0" />
                                            <GradientStop x:Name="GradStopB" Color="#FF2800" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Button x:Name="BtnGradEnd" Grid.Column="3" Style="{StaticResource SwatchBtn}" Margin="8,0,0,0" Background="#FF2800" ToolTip="结束颜色" />
                                <Button x:Name="BtnApplyGrad" Grid.Column="4" Style="{StaticResource BtnPrimary}" Content="应用渐变" Padding="13,0" Margin="12,0,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="预设" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Button x:Name="BtnPresetRainbow" Style="{StaticResource BtnGhost}" Height="27" Padding="9,0" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="11" Height="11" CornerRadius="6" Margin="0,0,6,0" BorderBrush="#33000000" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF5C5C" Offset="0" />
                                                    <GradientStop Color="#FFE95C" Offset="0.25" />
                                                    <GradientStop Color="#6FDF6F" Offset="0.5" />
                                                    <GradientStop Color="#5CB8FF" Offset="0.75" />
                                                    <GradientStop Color="#B07CFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="彩虹" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPresetIce" Style="{StaticResource BtnGhost}" Height="27" Padding="9,0" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="11" Height="11" CornerRadius="6" Margin="0,0,6,0" BorderBrush="#33000000" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#78FFFF" Offset="0" />
                                                    <GradientStop Color="#285AFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="冰蓝" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPresetLava" Style="{StaticResource BtnGhost}" Height="27" Padding="9,0" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="11" Height="11" CornerRadius="6" Margin="0,0,6,0" BorderBrush="#33000000" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFD23C" Offset="0" />
                                                    <GradientStop Color="#FF2800" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="熔岩" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPresetPurple" Style="{StaticResource BtnGhost}" Height="27" Padding="9,0" Margin="0,0,7,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="11" Height="11" CornerRadius="6" Margin="0,0,6,0" BorderBrush="#33000000" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#C85AFF" Offset="0" />
                                                    <GradientStop Color="#4782FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="紫色梦幻" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPresetGold" Style="{StaticResource BtnGhost}" Height="27" Padding="9,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="11" Height="11" CornerRadius="6" Margin="0,0,6,0" BorderBrush="#33000000" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FFF096" Offset="0" />
                                                    <GradientStop Color="#FFA014" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="金色" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ============ 右栏 · 预览与输出 ============ -->
                <StackPanel Grid.Column="1" x:Name="PanColRight" Margin="6,0,0,0">

                    <!-- 实时预览 -->
                    <Border Style="{StaticResource Card}" Padding="16,13,16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="实时预览" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Background="{DynamicResource BrushSurface2}" CornerRadius="7" Padding="2"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RSceneChat" Content="聊天" GroupName="SceneSeg" IsChecked="True" Style="{StaticResource SegRadio}" />
                                        <RadioButton x:Name="RSceneMotd" Content="MotD" GroupName="SceneSeg" Style="{StaticResource SegRadio}" Margin="2,0" />
                                        <RadioButton x:Name="RSceneTitle" Content="标题" GroupName="SceneSeg" Style="{StaticResource SegRadio}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 聊天场景 -->
                            <Grid x:Name="PanSceneChat">
                                <Border Background="#F0101013" CornerRadius="8" Padding="14,10" MinHeight="128">
                                    <Grid>
                                        <TextBlock x:Name="LabChatShadow" TextWrapping="Wrap" FontSize="14" LineHeight="25" TextTrimming="None">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="2" Y="2" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock x:Name="LabChatPreview" TextWrapping="Wrap" FontSize="14" LineHeight="25" />
                                        <TextBlock x:Name="LabChatEmpty" Text="输入文字开始生成…" Foreground="#88FFFFFF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- MotD 场景 -->
                            <Grid x:Name="PanSceneMotd" Visibility="Collapsed">
                                <Border Background="#F01C1C21" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,12" MinHeight="128">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="52" Height="52" CornerRadius="5" BorderBrush="#55FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#6CBB48" Offset="0.58" />
                                                    <GradientStop Color="#7A5230" Offset="0.58" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="缘" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock x:Name="LabMotdShadow" TextWrapping="Wrap" FontSize="13" LineHeight="21" MaxHeight="42" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform X="1.5" Y="1.5" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock x:Name="LabMotdPreview" TextWrapping="Wrap" FontSize="13" LineHeight="21" MaxHeight="42" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="LabMotdEmpty" Text="服务器 MotD 预览" Foreground="#66FFFFFF" FontSize="13" Visibility="Collapsed" />
                                            </Grid>
                                            <TextBlock Text="缘启 Server · 0 / 20 在线" FontSize="12" Foreground="#FF9A9AA0" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 标题场景 -->
                            <Grid x:Name="PanSceneTitle" Visibility="Collapsed">
                                <Border Background="#F0101013" CornerRadius="8" MinHeight="128">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                                        <TextBlock x:Name="LabTitleShadow" FontSize="27" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="100">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform X="2.5" Y="2.5" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock x:Name="LabTitlePreview" FontSize="27" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="100" />
                                        <TextBlock x:Name="LabTitleEmpty" Text="标题预览" Foreground="#88FFFFFF" FontSize="16" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Button x:Name="BtnInsertExample" Style="{StaticResource BtnGhost}" Height="28" Padding="10,0" HorizontalAlignment="Left" Content="插入示例" />
                                <TextBlock Text="深色底模拟游戏内聊天；§k 混淆段将动态乱码滚动" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 输出格式 -->
                    <Border Style="{StaticResource Card}" Padding="16,13,16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="输出格式" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Background="{DynamicResource BrushSurface2}" CornerRadius="7" Padding="2"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RFmtSection" Content="§ 码" GroupName="FormatSeg" IsChecked="True" Style="{StaticResource SegRadio}" />
                                        <RadioButton x:Name="RFmtAmp" Content="&amp; 码" GroupName="FormatSeg" Style="{StaticResource SegRadio}" Margin="2,0" />
                                        <RadioButton x:Name="RFmtJson" Content="JSON" GroupName="FormatSeg" Style="{StaticResource SegRadio}" Margin="0,0,2,0" />
                                        <RadioButton x:Name="RFmtMini" Content="MiniMessage" GroupName="FormatSeg" Style="{StaticResource SegRadio}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBox x:Name="TextColorOutput" Height="84" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"
                                     Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="9,7" />
                            <TextBlock x:Name="LabFormatNote" Margin="0,9,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushText3}"
                                       Text="提示 · §x 彩色码需要 BungeeCord / Spigot 系服务端支持；原版 1.16+ 完整支持请改用 JSON 格式。" />
                            <Grid Margin="0,10,0,0">
                                <TextBlock x:Name="LabOutStat" Text="输出 0 字符" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <Button x:Name="BtnColorCopy" Style="{StaticResource BtnPrimary}" Content="复制输出" HorizontalAlignment="Right" Padding="16,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
