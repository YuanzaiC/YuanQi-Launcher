<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageCommandQuery"
    PanScroll="PanBack">
    <local:MyPageRight.Resources>
        <!-- 分类胶囊 -->
        <Style x:Key="CatChip" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" />
                            <Border x:Name="Hl" Background="{DynamicResource BrushHover}" CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 指令卡片 -->
        <Style x:Key="CmdCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="15,12,15,13" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHover}" />
                    <Setter Property="Background" Value="{DynamicResource BrushSurface2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 候选行 -->
        <Style x:Key="CandRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,5,9,6" />
            <Setter Property="Margin" Value="6,1,6,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </local:MyPageRight.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 指令台 -->
        <Border x:Name="PanConsole" Style="{StaticResource Card}" Margin="24,18,24,0" Padding="16,13,16,14">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="指令台" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="LabConsoleState" Style="{StaticResource MutedText}" Margin="10,2,0,0"
                                   VerticalAlignment="Center" Text="输入指令，↑↓ 选候选，Tab / Enter 填入，Esc 收起" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <local:MyTextButton x:Name="BtnCopyCmd" Content="复制" FontSize="12" Cursor="Hand" VerticalAlignment="Center" />
                        <local:MyTextButton x:Name="BtnClearCmd" Content="清空" FontSize="12" Cursor="Hand" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 输入行 -->
                <Border x:Name="PanInput" Margin="0,11,0,0" Height="36" CornerRadius="6"
                        Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="/" FontFamily="Consolas" FontSize="15" Margin="11,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushText3}" />
                        <TextBox x:Name="TxtCmd" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="13.5" VerticalContentAlignment="Center"
                                 Padding="0,0,10,0" Foreground="{DynamicResource BrushText1}" />
                    </Grid>
                </Border>

                <!-- 当前参数提示 -->
                <TextBlock x:Name="LabArgHint" Style="{StaticResource MutedText}" Margin="2,8,2,0" TextWrapping="Wrap" />

                <!-- 候选面板 -->
                <Border x:Name="PanCand" Visibility="Collapsed" Margin="0,10,0,0" MaxHeight="232" CornerRadius="6"
                        Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LabCandHead" Style="{StaticResource MutedText}" Margin="12,8,12,3" />
                        <ScrollViewer x:Name="PanCandScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                            <StackPanel x:Name="PanCandList" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 最近使用 -->
                <WrapPanel x:Name="PanRecent" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- 指令列表 -->
        <local:MyScrollViewer x:Name="PanBack" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,14,24,26">
                <local:MySearchBox x:Name="PanSearch" Margin="0,0,0,0" HintText="搜索指令、功能或参数，例如 give / 传送 / 实体" />
                <WrapPanel x:Name="PanCats" Margin="0,6,0,0" />
                <StackPanel x:Name="PanList" Margin="0,2,0,0" />
                <TextBlock x:Name="LabEmpty" Text="没有找到匹配的指令，换个关键词试试" Style="{StaticResource MutedText}"
                           Margin="4,26,4,0" Visibility="Collapsed" />
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
