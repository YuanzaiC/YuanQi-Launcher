<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageGameStats"
    PanScroll="PanBack">
    <local:MyPageRight.Resources>
        <!-- 时间范围胶囊：自带模板，hover 只在底色上叠一层淡淡的灰，不会把选中态的绿色覆盖掉 -->
        <Style x:Key="RangeChip" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" />
                            <Border x:Name="Hl" Background="{DynamicResource BrushHover}" CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 总览小卡 -->
        <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource CardFlat}">
            <Setter Property="Padding" Value="14,12,14,12" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText3}" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText1}" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KpiSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText3}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </local:MyPageRight.Resources>

    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,26">

            <!-- 标题 + 时间范围 -->
            <Grid x:Name="PanHead" Margin="2,0,2,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="游戏统计" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" />
                    <TextBlock x:Name="LabRangeDesc" Text="—" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRangeDay" Style="{StaticResource RangeChip}" Content="近 1 天" Margin="0,0,0,0" />
                    <Button x:Name="BtnRangeWeek" Style="{StaticResource RangeChip}" Content="近 1 周" />
                    <Button x:Name="BtnRangeMonth" Style="{StaticResource RangeChip}" Content="近 1 月" />
                    <Button x:Name="BtnRangeCustom" Style="{StaticResource RangeChip}" Content="自定义" />
                </StackPanel>
            </Grid>

            <!-- 自定义范围 -->
            <Border x:Name="PanCustom" Style="{StaticResource CardFlat}" Padding="14,10,14,10" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="开始" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource BrushText2}" />
                    <TextBox x:Name="TxtFrom" Style="{StaticResource InputBox}" Width="118" Height="30" Margin="8,0,0,0" />
                    <TextBlock Text="结束" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource BrushText2}" />
                    <TextBox x:Name="TxtTo" Style="{StaticResource InputBox}" Width="118" Height="30" Margin="8,0,0,0" />
                    <Button x:Name="BtnApply" Style="{StaticResource BtnPrimary}" Content="应用" Height="30" Padding="18,0" Margin="12,0,0,0" />
                    <TextBlock Text="格式 yyyy-MM-dd，最多可查最近 120 天" Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 总览 -->
            <UniformGrid x:Name="PanKpi" Rows="1" Columns="4" Margin="0,12,0,0">
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="总游玩时长" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="LabKpiTotal" Text="—" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="LabKpiTotalSub" Text="—" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="游玩天数" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="LabKpiDays" Text="—" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="LabKpiDaysSub" Text="—" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="日均时长" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="LabKpiAvg" Text="—" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="LabKpiAvgSub" Text="—" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="单日最长" Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="LabKpiBest" Text="—" Style="{StaticResource KpiValue}" />
                        <TextBlock x:Name="LabKpiBestSub" Text="—" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 每日游玩时长 -->
            <Border x:Name="PanDaysCard" Style="{StaticResource Card}" Padding="16,13,16,10" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="每日游玩时长" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="LabDaysPeak" Text="" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushText3}" />
                    </Grid>
                    <Canvas x:Name="PanChartDays" Height="126" Margin="0,10,0,0" ClipToBounds="True" />
                </StackPanel>
            </Border>

            <!-- 实例排行 + 时段分布 -->
            <Grid x:Name="PanSplit" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,13,16,10">
                    <StackPanel>
                        <TextBlock Text="实例时长排行" Style="{StaticResource CardTitle}" />
                        <StackPanel x:Name="PanRank" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,13,16,10">
                    <StackPanel>
                        <TextBlock Text="游玩时段分布" Style="{StaticResource CardTitle}" />
                        <Canvas x:Name="PanChartHour" Height="150" Margin="0,10,0,0" ClipToBounds="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最近游玩 -->
            <Border x:Name="PanRecentCard" Style="{StaticResource Card}" Padding="16,13,16,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="最近游玩" Style="{StaticResource CardTitle}" />
                    <StackPanel x:Name="PanRecentList" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
