<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageOreGuide"
    PanScroll="PanBack">
    <local:MyPageRight.Resources>
        <!-- 维度分段切换 -->
        <Style x:Key="DimTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="14,6" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurface}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:MyPageRight.Resources>
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="24,22,24,26">

            <!-- 标题 -->
            <Grid Margin="2,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="矿石分布" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Y 层挖掘指南" Style="{StaticResource PageSub}" />
                </StackPanel>
                <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Java 1.18+ · 简化分布模型" FontSize="11.5" Foreground="{DynamicResource BrushText2}" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- 维度切换 -->
            <Border x:Name="PanDimTabs" Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="2,0,2,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioOverworld" Content="主世界 · Y -64~319" GroupName="OreDim" IsChecked="True" Style="{StaticResource DimTab}" />
                    <RadioButton x:Name="RadioNether" Content="下界 · Y 0~127" GroupName="OreDim" Style="{StaticResource DimTab}" Margin="2,0,0,0" />
                </StackPanel>
            </Border>

            <!-- 矿石选择 -->
            <WrapPanel x:Name="PanOreChips" Margin="2,0,2,12" />

            <!-- 当前目标 + Y 层检查器 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <!-- 当前目标 -->
                <Border Grid.Column="0" x:Name="PanTargetCard" Style="{StaticResource Card}" Padding="18,14,18,14" CacheMode="BitmapCache" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="PanTargetIcon" Width="38" Height="38" VerticalAlignment="Center" />
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LabTargetKicker" Text="当前目标" FontSize="11" Foreground="{DynamicResource BrushText3}" />
                                    <TextBlock x:Name="LabTargetOre" Text="—" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="实用开采层" FontSize="11.5" Foreground="{DynamicResource BrushText3}" />
                        <TextBlock x:Name="LabTargetBestY" Text="Y —" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" Margin="0,2,0,8" />
                        <TextBlock x:Name="LabTargetDesc" Text="" FontSize="12.5" Foreground="{DynamicResource BrushText2}" TextWrapping="Wrap" LineHeight="20" />
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <Border Background="{DynamicResource BrushSurface2}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="生成范围" FontSize="10.5" Foreground="{DynamicResource BrushText3}" />
                                    <TextBlock x:Name="LabStatRange" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BrushSurface2}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="规则峰值" FontSize="10.5" Foreground="{DynamicResource BrushText3}" />
                                    <TextBlock x:Name="LabStatPeak" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BrushSurface2}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="最大矿脉" FontSize="10.5" Foreground="{DynamicResource BrushText3}" />
                                    <TextBlock x:Name="LabStatVein" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BrushSurface2}" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="空气丢弃率" FontSize="10.5" Foreground="{DynamicResource BrushText3}" />
                                    <TextBlock x:Name="LabStatAir" Text="—" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Grid Margin="0,14,0,0">
                            <Button x:Name="BtnCopy" Style="{StaticResource BtnPrimary}" Content="复制当前结论" HorizontalAlignment="Left" Padding="14,0" />
                            <TextBlock x:Name="LabTargetNote" Text="" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Y 层检查器 -->
                <Border Grid.Column="2" x:Name="PanInspectorCard" Style="{StaticResource Card}" Padding="18,14,18,14" CacheMode="BitmapCache" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource CardTitle}" VerticalAlignment="Center">
                                <Run Text="Y " Foreground="{DynamicResource ColorBrush3}" /><Run Text="层检查器" />
                            </TextBlock>
                            <Button x:Name="BtnBackToBest" Style="{StaticResource BtnSmall}" Content="回到建议层" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="当前 Y" FontSize="11.5" Foreground="{DynamicResource BrushText3}" />
                        <TextBlock x:Name="LabInspectorY" Text="—" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" Margin="0,2,0,8" />
                        <Border Background="{DynamicResource BrushAccentSoft2}" CornerRadius="6" Padding="11,9" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="LabInspectorPercent" Text="相对自身峰值 —" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" />
                                <TextBlock Text="相对权重仅在同一种矿石内比较，不代表挖到概率" FontSize="10.5" Foreground="{DynamicResource BrushText3}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <local:MySlider x:Name="SliderY" MaxValue="383" Value="6" />
                        <Grid Margin="2,5,2,0">
                            <TextBlock x:Name="LabSliderMin" Text="-64" FontSize="10.5" Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="LabSliderMax" Text="319" FontSize="10.5" Foreground="{DynamicResource BrushText3}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="输入精确 Y 层" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                            <local:MyTextBox x:Name="TextYInput" Width="96" Height="28" FontSize="12.5" HorizontalAlignment="Right" HintText="-58" />
                        </Grid>
                        <TextBlock Text="此层命中的生成规则" FontSize="11.5" Foreground="{DynamicResource BrushText3}" Margin="0,14,0,6" />
                        <StackPanel x:Name="PanInspectorRules" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 分布图 -->
            <Border x:Name="PanChartCard" Style="{StaticResource Card}" Padding="18,14,18,14" Margin="0,12,0,0" CacheMode="BitmapCache">
                <StackPanel>
                    <TextBlock Text="同一坐标轴对照" FontSize="11" Foreground="{DynamicResource BrushText3}" />
                    <TextBlock x:Name="LabChartTitle" Text="主世界矿石完整分布" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" Margin="0,2,0,2" />
                    <TextBlock x:Name="LabChartNote" Text="" Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <!-- 坐标轴：一条完整的基线 + 刻度短竖线 + 刻度值（与色带列对齐） -->
                    <Grid Margin="172,0,76,0">
                        <UniformGrid x:Name="PanChartAxis" Rows="1" />
                        <UniformGrid x:Name="PanAxisLabels" Rows="1" />
                        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BrushText3}" Opacity="0.6" />
                    </Grid>
                    <StackPanel x:Name="PanChartRows" Margin="0,4,0,0" />
                    <Grid Margin="172,8,76,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource ColorBrush4}" Opacity="0.3" VerticalAlignment="Center" />
                            <TextBlock Text="低" FontSize="11" Foreground="{DynamicResource BrushText3}" Margin="5,0,14,0" VerticalAlignment="Center" />
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource ColorBrush4}" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="中" FontSize="11" Foreground="{DynamicResource BrushText3}" Margin="5,0,14,0" VerticalAlignment="Center" />
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                            <TextBlock Text="峰值" FontSize="11" Foreground="{DynamicResource BrushText3}" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LabChartCurrent" Text="当前 Y：—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushText2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
