<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageOtherAbout"
    PanScroll="PanBack" RenderOptions.BitmapScalingMode="HighQuality">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="24,22,24,26" Grid.IsSharedSizeScope="True">

            <!-- 品牌 · 版本 · 致谢（关于页首位给出 PCL 原作者署名与赞助链接） -->
            <local:MyCard Margin="0,15" Title="关于">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/YuanQi Launcher;component/Images/YQL.png" Width="48" Height="48"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,48,48" RadiusX="10" RadiusY="10" />
                        </Image.Clip>
                    </Image>
                    <local:MyListItem IsHitTestVisible="False" x:Name="ItemAboutPcl" Margin="-7,0,0,0" Grid.Column="1"
                                      Title="缘启 YuanQi Launcher (YQL)"
                                      Info="基于 Plain Craft Launcher 深度定制的 Minecraft 启动器&#xa;当前版本：%VERSION%（%VERSIONCODE%.%BRANCH%）" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="2,2,0,8">
                        <TextBlock LineHeight="18" Text="本项目是基于龙腾猫跃 (LTCat) 开发的 Plain Craft Launcher (PCL) 2.14.0.0 开源版本，由第三方独立进行的二次创作产物，与 PCL 官方无关。" TextWrapping="Wrap" />
                        <TextBlock LineHeight="18" Margin="0,6,0,0" Text="衷心感谢龙腾猫跃与所有 PCL 贡献者的付出。如果你喜欢 PCL，欢迎赞助支持原作者！" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <local:MyButton Text="赞助原作 PCL" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ColorType="Highlight"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://meloong.com/afd/a/LTCat" />
                        <local:MyButton Text="PCL 开源仓库" MinWidth="140" Padding="13,0" Margin="0,0,20,0"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://github.com/Meloong-Git/PCL" />
                        <local:MyButton x:Name="BtnAboutFeedback" Text="提交反馈" MinWidth="140" Padding="13,0"
                                        ToolTip="提交使用中遇到的问题或建议" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <!-- 作者（次要信息，保持轻量） -->
            <local:MyCard Margin="0,0,0,15" Title="作者" IsSwapped="True" CanSwap="True">
                <Grid Margin="21,36,21,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/YuanQi Launcher;component/Images/AuthorAvatar.jpg" Width="42" Height="42"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,1,0,0" Opacity="0.92"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,42,42" RadiusX="9" RadiusY="9" />
                        </Image.Clip>
                    </Image>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="缘栽" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource ColorBrushGray2}" />
                        <TextBlock FontSize="12" LineHeight="17" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource ColorBrushGray4}"
                                   Text="缘启（YQL）的作者与维护者。本项目基于 Plain Craft Launcher 2.14.0.0 开源版本二次创作，界面重做、陶瓦联机接入与启动优化等改动均由 缘栽 完成，欢迎反馈问题与建议。" />
                    </StackPanel>
                </Grid>
            </local:MyCard>


            <!-- 开源与许可说明 -->
            <local:MyCard Margin="0,0,0,15" Title="开源与许可说明" IsSwapped="True" CanSwap="True">
                <StackPanel Margin="25,39,23,20">
                    <TextBlock LineHeight="18" Text="缘启是基于 Plain Craft Launcher (PCL) 开源版本（仓库：https://github.com/Meloong-Git/PCL）的二次创作，遵循《PCL 分发有限许可》与《PCL 存储库合理使用指南》：" TextWrapping="Wrap" />
                    <TextBlock LineHeight="18" Margin="0,8,0,0" Text="· 本软件为第三方基于 PCL 独立进行二次创作的产物；&#xa;· 在本关于页面给出原作者龙腾猫跃的署名及其对应的赞助链接；&#xa;· 公开修改后的源代码，并继续以《PCL 存储库合理使用指南》（可参考 CC BY-SA 协议）作为许可指南；&#xa;· 保留对 Minecraft 正版购买的支持与劝导。" TextWrapping="Wrap" />
                    <TextBlock LineHeight="18" Margin="0,8,0,0" Text="缘启未包含 PCL 正式版中的赞助解锁体系（土豆码、赞助等级、主题解锁等），相关功能已按定制需求移除或全面开放。如果你希望支持 PCL 原作者，请使用上方的赞助链接。" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Height="35" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <local:MyButton Text="PCL 分发有限许可" Width="170" Padding="13,0" Margin="0,0,20,0" ColorType="Highlight"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://shimo.im/docs/rGrd8pY8xWkt6ryW#anchor-X0bo" />
                        <local:MyButton Text="PCL 存储库使用指南" Width="170" Padding="13,0" Margin="0,0,20,0"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://github.com/Meloong-Git/PCL/blob/main/LICENCE" />
                        <local:MyButton Text="PCL 反馈讨论区" Width="170" Padding="13,0"
                                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://github.com/Meloong-Git/PCL/discussions" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <!-- 法律信息 -->
            <local:MyCard Margin="0,0,0,15" Title="法律信息" IsSwapped="True" CanSwap="True">
                <StackPanel Margin="25,39,23,20">
                    <TextBlock Text="隐私声明与个人信息保护政策" TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold" />
                    <TextBlock Margin="0,0,0,2" LineHeight="17" Text="缘启不收集、不上传任何个人信息，也没有内置任何数据上报通道。&#xa;你的登录凭据、设置与缓存仅保存在本机，并且可以在任何时候手动删除。" TextWrapping="Wrap" />
                    <TextBlock Text="其他信息" TextWrapping="Wrap" Margin="0,10,0,4" FontWeight="Bold" />
                    <TextBlock Margin="0,0,0,2" LineHeight="17" Text="缘启 (YuanQi Launcher, YQL) 基于 Plain Craft Launcher 2.14.0.0 开源版本二次开发，原程序的著作权归其原作者所有。&#xa;非 MINECRAFT 官方产品。未经 MOJANG 或 MICROSOFT 批准，也不与 MOJANG 或 MICROSOFT 关联。" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>


