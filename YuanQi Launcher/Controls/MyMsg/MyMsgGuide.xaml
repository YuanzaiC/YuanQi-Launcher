<Grid x:Class="MyMsgGuide"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:my="clr-namespace:YuanQi"
      RenderTransformOrigin="0,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
      MinWidth="540" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="TransformRotate" Angle="-3" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border Name="PanBorder" CornerRadius="7" Background="#FBFBFB">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="20" ShadowDepth="4" RenderingBias="Performance" Opacity="0.8" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="23" TextTrimming="None" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left"
                       Name="LabTitle" Margin="7,-1,70,9" Text="使用引导" VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />

            <Grid Grid.Row="3" x:Name="PanSteps" Margin="7,0,7,0" MinHeight="196">
                <StackPanel x:Name="PanStep1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Image Source="pack://application:,,,/YuanQi Launcher;component/Images/YQL.png" Width="58" Height="58"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,58,58" RadiusX="13" RadiusY="13" />
                            </Image.Clip>
                        </Image>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="缘启 YuanQi Launcher" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="作者：缘栽" FontSize="13" Opacity="0.6" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="#FF5C5C5C"
                               Text="缘启（YuanQi Launcher，简称 YQL）是基于 Plain Craft Launcher 2.14.0.0 开源版本二次创作的开源 Minecraft 启动器，由 缘栽 独立开发与维护。" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="#FF5C5C5C" Margin="0,10,0,0"
                               Text="这份引导只要半分钟，带你认一下最常用的几个地方。" />
                </StackPanel>
                <StackPanel x:Name="PanStep2" Visibility="Collapsed">
                    <TextBlock Text="第一步 · 启动游戏" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="#FF5C5C5C"
                               Text="在左侧「启动」页选择一个 Minecraft 文件夹（或新建一个），再挑选要启动的游戏版本。" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="#FF5C5C5C" Margin="0,10,0,0"
                               Text="还没有游戏版本？去「下载」页装一个就行。启动前也可以在「设置 → 启动」里调整内存与 Java。" />
                </StackPanel>
                <StackPanel x:Name="PanStep3" Visibility="Collapsed">
                    <TextBlock Text="第二步 · 和朋友联机" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="#FF5C5C5C"
                               Text="打开左侧「联机」页，点「创建房间」即可开一间房，把邀请码发给朋友就能加入。" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="#FF5C5C5C" Margin="0,10,0,0"
                               Text="联机由 陶瓦联机（Terracotta）提供，不需要端口映射，也不用额外安装软件。" />
                </StackPanel>
                <StackPanel x:Name="PanStep4" Visibility="Collapsed">
                    <TextBlock Text="第三步 · 调成你喜欢的样子" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="#FF5C5C5C"
                               Text="「设置 → 个性化」里可以更换主题色、背景图与启动动画；「设置 → 其他」里能导出 / 导入设置，也能再次打开这份引导。" />
                    <TextBlock TextWrapping="Wrap" LineHeight="21" FontSize="14" Foreground="#FF5C5C5C" Margin="0,10,0,0"
                               Text="遇到问题时，可以在「其他 → 关于」里找到作者、许可与项目说明。祝你玩得开心！" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="7,20,0,0">
                <Rectangle x:Name="Dot1" Width="22" Height="4" RadiusX="2" RadiusY="2" Margin="0,0,6,0" Fill="{DynamicResource ColorBrush3}" />
                <Rectangle x:Name="Dot2" Width="22" Height="4" RadiusX="2" RadiusY="2" Margin="0,0,6,0" Fill="{DynamicResource ColorBrush3}" Opacity="0.22" />
                <Rectangle x:Name="Dot3" Width="22" Height="4" RadiusX="2" RadiusY="2" Margin="0,0,6,0" Fill="{DynamicResource ColorBrush3}" Opacity="0.22" />
                <Rectangle x:Name="Dot4" Width="22" Height="4" RadiusX="2" RadiusY="2" Margin="0,0,6,0" Fill="{DynamicResource ColorBrush3}" Opacity="0.22" />
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,20,0,0">
                <my:MyButton x:Name="BtnSkip" HorizontalAlignment="Left" Text="跳过引导" Padding="13,6" ColorType="Normal" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <my:MyButton x:Name="BtnPrev" Text="上一步" Padding="13,6" Margin="0,0,12,0" Visibility="Collapsed" />
                    <my:MyButton x:Name="BtnNext" Text="下一步" Padding="13,6" ColorType="Highlight" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Grid>
