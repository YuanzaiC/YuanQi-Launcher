<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:YuanQi"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    x:Name="WindMain" x:Class="FormMain" Style="{StaticResource MyWindow}"
    TextElement.Foreground="{DynamicResource ColorBrush1}"
    AllowDrop="True" Topmost="False" Title="缘启 YuanQi Launcher　" AllowsTransparency="True" MinHeight="640" MinWidth="1040"
    ScrollViewer.VerticalScrollBarVisibility="Disabled" Icon="/YuanQi Launcher;component/Images/icon.ico" WindowStyle="None" 
    ResizeMode="CanResize" Background="{x:Null}" d:DesignWidth="1360" d:DesignHeight="840" Width="1360" Height="840" 
    RenderTransformOrigin="0.5,0.5">
    <Window.Resources>
        <!-- 标题栏按钮：46×40，悬停浅灰，关闭键悬停红 -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushText1}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AvatarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="1000" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ColorBrush5}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 标题栏返回键：胶囊幽灵按钮，悬停高亮，含返回箭头 + 次级页面名 -->
        <Style x:Key="TitleBackButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,0,10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushText1}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushTitleCloseHover}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ThumbnailClipMargin="{Binding Margin, ElementName=PanForm}" />
    </Window.TaskbarItemInfo>
    <Grid x:Name="PanBack" SnapsToDevicePixels="True" UseLayoutRounding="True" Margin="0" RenderTransformOrigin="0.5,0.5">
        <Rectangle x:Name="ResizerT" Stroke="{x:Null}" StrokeThickness="0.0001" Height="8" VerticalAlignment="Top" Margin="13,0" Cursor="SizeNS">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#21000000" Offset="1" />
                    <GradientStop Color="#11000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerB" Stroke="{x:Null}" StrokeThickness="0.0001" Height="8" VerticalAlignment="Bottom" Margin="13,0" Cursor="SizeNS">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#21000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="0.3" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerR" HorizontalAlignment="Right" Margin="0,13" Stroke="{x:Null}" StrokeThickness="0.0001" Width="8" Cursor="SizeWE">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#21000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="0.3" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerL" HorizontalAlignment="Left" Stroke="{x:Null}" Width="8" Margin="0,13" StrokeThickness="0.0001" Cursor="SizeWE">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#21000000" Offset="1" />
                    <GradientStop Color="#11000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerLT" HorizontalAlignment="Left" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Top" Height="13" Cursor="SizeNWSE">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerLB" HorizontalAlignment="Left" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Bottom" Height="13" Cursor="SizeNESW">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerRB" HorizontalAlignment="Right" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Bottom" Height="13" Cursor="SizeNWSE">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerRT" HorizontalAlignment="Right" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Top" Height="13" Cursor="SizeNESW">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border Margin="8" x:Name="BorderForm" Background="#E9ECEF" BorderBrush="#DADEE3" BorderThickness="1">
            <Border.Clip>
                <RectangleGeometry x:Name="RectForm" RadiusX="8" RadiusY="8" />
            </Border.Clip>
            <Grid x:Name="PanForm" SnapsToDevicePixels="False" UseLayoutRounding="False" Background="#F3F3F3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Canvas x:Name="ImgBack" IsHitTestVisible="False" Grid.Row="1" RenderOptions.BitmapScalingMode="LowQuality"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <!-- ==================== 标题栏（40px） ==================== -->
                <Grid x:Name="PanTitle" Height="40" Background="{DynamicResource BrushSurface}">
                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="14,0,0,0">
                        <Border x:Name="PanTitleBadge" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.3,0">
                                    <GradientStop Color="{DynamicResource ColorObject3}" Offset="0" />
                                    <GradientStop Color="#2F6D22" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="Y" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="None" />
                        </Border>
                        <TextBlock x:Name="LabTitleLogo" Text="缘启" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushText2}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="None" />
                        <local:MyImage x:Name="ImageTitleLogo" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" Height="20" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Path x:Name="ShapeTitleLogo" Data="M26,29 v-25 h6 a7,7 180 0 1 0,14 h-6" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" Stretch="fill" Stroke="{StaticResource ColorBrush1}" StrokeThickness="2.2" Width="20" Height="16" Visibility="Collapsed" />
                        <!-- 面包屑：主页面 -->
                        <Grid x:Name="PanTitleMain" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="/" FontSize="12.5" Foreground="{DynamicResource BrushText3}" VerticalAlignment="Center" Margin="0,0,5,0" TextTrimming="None" />
                                <TextBlock x:Name="LabTitleCrumb" Text="启动" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushText1}" VerticalAlignment="Center" TextTrimming="None" />
                            </StackPanel>
                        </Grid>
                        <!-- 面包屑：次级页面 -->
                        <Grid x:Name="PanTitleInner" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center" Margin="0,0,0,0">
                            <Button x:Name="BtnTitleInner" Style="{StaticResource TitleBackButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M6.5,2 L2.5,7 L6.5,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="7" Height="13" Stretch="Uniform" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True" />
                                    <TextBlock SnapsToDevicePixels="False" IsHitTestVisible="False" Name="LabTitleInner" VerticalAlignment="Center" Margin="6,0,0,0" HorizontalAlignment="Left"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="BtnTitleMin" Style="{StaticResource TitleBarButton}" ToolTip="最小化" AutomationProperties.Name="最小化">
                            <Path Data="M0,0 h10 v1.2 h-10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="BtnTitleMax" Style="{StaticResource TitleBarButton}" ToolTip="最大化" AutomationProperties.Name="最大化">
                            <Path Data="M0,0 h9 v9 h-9 Z M1,1 v7 h7 v-7 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="BtnTitleClose" Style="{StaticResource TitleBarCloseButton}" ToolTip="关闭" AutomationProperties.Name="关闭">
                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                    <Rectangle x:Name="PanTitleDragArea" Fill="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,138,0" IsHitTestVisible="False" />
                </Grid>

                <!-- ==================== 左侧主图标栏（72px） ==================== -->
                <Border x:Name="PanNavRail" Grid.Row="1" Width="72" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" SnapsToDevicePixels="True">
                    <Grid>
                        <StackPanel x:Name="PanTitleSelect" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <local:MyNavItem x:Name="BtnTitleSelect0" Text="启动" Tag="0" Checked="True" Logo="M52.1,164.5c-1.4,0-3.1-0.5-4.2-1.3c-2.6-1.7-4-4.2-4-7V43.8c0-2.9,1.6-5.8,4.1-7c1.2-0.8,2.7-1.2,4.1-1.2c1.5,0,2.9,0.4,4.2,1.2L153.1,93c0,0,0.1,0,0.1,0.1c2.6,1.7,4,4.2,4,7c0,3-1.7,5.8-4.2,7.1l-96.8,56.2C55.1,164,53.5,164.5,52.1,164.5z M60.4,142.1l72.1-42.1L60.4,58.2V142.1z" />
                            <local:MyNavItem x:Name="BtnTitleSelect1" Text="下载" Tag="1" Logo="M955 610h-59c-15 0-29 13-29 29v196c0 15-13 29-29 29h-649c-15 0-29-13-29-29v-196c0-15-13-29-29-29h-59c-15 0-29 13-29 29V905c0 43 35 78 78 78h787c43 0 78-35 78-78V640c0-15-13-29-29-29zM492 740c11 11 29 11 41 0l265-265c11-11 11-29 0-41l-41-41c-11-11-29-11-41 0l-110 110c-11 11-33 3-33-13V68C571 53 555 39 541 39h-59c-15 0-29 13-29 29v417c0 17-21 25-33 13l-110-110c-11-11-29-11-41 0L226 433c-11 11-11 29 0 41L492 740z" />
                            <local:MyNavItem x:Name="BtnTitleSelect2" Text="联机" Tag="2" Logo="F0 M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 Z M10,4.6 A5.4,5.4 0 1 1 10,15.4 A5.4,5.4 0 1 1 10,4.6 Z M9.2,2.6 h1.6 v14.8 h-1.6 Z M2.6,9.2 h14.8 v1.6 h-14.8 Z" />
                            <local:MyNavItem x:Name="BtnTitleSelectSeedMap" Text="种子" Tag="13" Logo="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z" />
                            <local:MyNavItem x:Name="BtnTitleSelect3" Text="设置" Tag="3" Logo="M940.4 463.7L773.3 174.2c-17.3-30-49.2-48.4-83.8-48.4H340.2c-34.6 0-66.5 18.5-83.8 48.4L89.2 463.7c-17.3 30-17.3 66.9 0 96.8L256.4 850c17.3 30 49.2 48.4 83.8 48.4h349.2c34.6 0 66.5-18.5 83.8-48.4l167.2-289.5c17.3-29.9 17.3-66.8 0-96.8z m-94.6 96.8L725.9 768.1c-17.3 30-49.2 48.4-83.8 48.4H387.5c-34.6 0-66.5-18.5-83.8-48.4L183.9 560.5c-17.3-30-17.3-66.9 0-96.8l119.8-207.5c17.3-30 49.2-48.4 83.8-48.4h254.6c34.6 0 66.5 18.5 83.8 48.4l119.8 207.5c17.3 30 17.3 66.9 0.1 96.8z M522.3 321.2c-2.5-0.1-5-0.2-7.5-0.2-119.9 0-214 110.3-186.3 235 15.8 70.9 71.5 126.6 142.4 142.4 17.5 3.9 34.7 5.4 51.4 4.7 102.1-3.9 183.6-87.9 183.6-191 0.1-103-81.5-187-183.6-190.9z m68.6 269.1c-18.5 18-43 28.9-68.6 30.7l-6 0.3c-30.2 0.4-58.6-11.4-79.7-33-19.5-20.1-30.7-47-30.9-75-0.3-29.6 11.1-57.4 32-78.3 20.6-20.6 48-32 77.2-32 2.5 0 5 0.1 7.5 0.3 26.7 1.8 51.5 13.2 70.5 32.5 19.6 20 30.8 46.9 31.2 74.9 0.2 30.2-11.5 58.6-33.2 79.6z" />
                            <local:MyNavItem x:Name="BtnTitleSelect4" Text="工具箱" Tag="12" Logo="M8,2.2 h4 v2.6 h-4 Z M2,6 h16 v10.5 a1.2,1.2 0 0 1 -1.2,1.2 h-13.6 a1.2,1.2 0 0 1 -1.2,-1.2 Z M9.05,8.3 h1.9 v2.2 h-1.9 Z" />
                            <local:MyNavItem x:Name="BtnTitleSelect5" Text="关于" Tag="4" Logo="M512 917.333333c223.861333 0 405.333333-181.472 405.333333-405.333333S735.861333 106.666667 512 106.666667 106.666667 288.138667 106.666667 512s181.472 405.333333 405.333333 405.333333z m0 106.666667C229.226667 1024 0 794.773333 0 512S229.226667 0 512 0s512 229.226667 512 512-229.226667 512-512 512z m-32-597.333333h64a21.333333 21.333333 0 0 1 21.333333 21.333333v320a21.333333 21.333333 0 0 1-21.333333 21.333333h-64a21.333333 21.333333 0 0 1-21.333333-21.333333V448a21.333333 21.333333 0 0 1 21.333333-21.333333z m0-192h64a21.333333 21.333333 0 0 1 21.333333 21.333333v64a21.333333 21.333333 0 0 1-21.333333 21.333333h-64a21.333333 21.333333 0 0 1-21.333333-21.333333v-64a21.333333 21.333333 0 0 1 21.333333-21.333333z" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Rectangle Width="24" Height="1" Fill="{DynamicResource BrushBorder}" HorizontalAlignment="Center" Margin="0,6,0,6" />
                            <Button x:Name="BtnRailToggle" Width="34" Height="34" Style="{StaticResource BtnGhost}" ToolTip="收起/展开导航" Padding="0" AutomationProperties.Name="收起导航">
                                <Path x:Name="PathRailToggle" Data="M12.5,5 L7.5,10 L12.5,15" Stroke="{DynamicResource BrushText3}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="BtnAvatar" Width="42" Height="42" Margin="0,6,0,0" ToolTip="账户" AutomationProperties.Name="账户" Style="{StaticResource AvatarButton}">
                                <Grid>
                                    <local:MySkinHead x:Name="ImgAvatarHead" Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource ColorBrush3}" Stroke="{DynamicResource BrushSurface}" StrokeThickness="2"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== 二级菜单背景（由页面宽度驱动） ==================== -->
                <Grid x:Name="PanLeft" Grid.Row="1" HorizontalAlignment="Left" SnapsToDevicePixels="True" Margin="72,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="RectLeftBackground" Width="0" Fill="{DynamicResource BrushSurface}" IsHitTestVisible="False" />
                    <Rectangle x:Name="RectLeftShadow" Width="10" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.Column="1" >
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" Opacity="0.06">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- ==================== 内容区 ==================== -->
                <Grid x:Name="PanMain" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="72,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Grid.IsSharedSizeScope="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Border x:Name="PanMainRight" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="False" SnapsToDevicePixels="False">
                        </Border>
                    </Border>
                    <Border Grid.IsSharedSizeScope="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Border x:Name="PanMainLeft" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="False" SnapsToDevicePixels="False">
                        </Border>
                    </Border>
                </Grid>
                <!-- 浮动返回键：用 Popup 承载以覆盖 WebView2 原生窗口（子页面时显示于内容区左下角） -->
                <Popup x:Name="PopFloatingBack" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PanForm}"
                       HorizontalOffset="88" VerticalOffset="-48" StaysOpen="True" IsOpen="False">
                    <Button x:Name="BtnFloatingBack" Width="34" Height="34"
                            Cursor="Hand" ToolTip="返回上一页" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="17">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
