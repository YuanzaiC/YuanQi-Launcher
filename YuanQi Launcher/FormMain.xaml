                <!-- ==================== 启动动画覆盖层（纯白界面 → 启动器图标淡入 → 起飞中渐变为实例图标并融入主页，播放完毕后折叠） ==================== -->
                <Grid x:Name="PanSplash" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
                    <Rectangle x:Name="RectSplashWhite" Fill="#FFFFFF" />
                    <!-- 国庆动画：白底淡入为「绛红 / 故宫红」渐变（暗红为主，不使用纯红） -->
                    <Rectangle x:Name="RectSplashNational" Opacity="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.75,1">
                                <GradientStop Color="#3A0A0A" Offset="0" />
                                <GradientStop Color="#5C1010" Offset="0.35" />
                                <GradientStop Color="#8C1C13" Offset="0.72" />
                                <GradientStop Color="#7A1F1F" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 春节动画：极低透明度的年味纹理（细金线菱格），只做气氛不抢主体 -->
                    <Rectangle x:Name="RectSplashTexture" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,26,26" ViewportUnits="Absolute" Stretch="None">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="0,0" EndPoint="13,13" />
                                                <LineGeometry StartPoint="13,13" EndPoint="26,0" />
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#F0D9A0" Thickness="0.6" />
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border x:Name="SplashBlock" Width="104" Height="104" CornerRadius="22" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource BrushSurface2}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5"
                            RenderTransformOrigin="0.5,0.5">
                        <!-- 不要开 ClipToBounds：它会把投影裁进元素边界，阴影就变成硬边的方形块；
                             圆角裁切由内部 Grid 的 RectangleGeometry 负责，图片照样不会溢出圆角。 -->
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.13" RenderingBias="Performance" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="SplashBlockScale" ScaleX="0.9" ScaleY="0.9" />
                                <TranslateTransform x:Name="SplashBlockPos" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.Clip>
                                <!-- 与卡片圆角匹配的内圆角裁切（卡片 104、边框 1.5、外圆角 22 → 内容 101、内圆角 20.5） -->
                                <RectangleGeometry Rect="0,0,101,101" RadiusX="20.5" RadiusY="20.5" />
                            </Grid.Clip>
                            <local:MyImage x:Name="ImgSplashInstance" Stretch="UniformToFill" />
                            <local:MyImage x:Name="ImgSplashInstanceNext" Stretch="UniformToFill" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>
                <!-- ==================== 彩蛋动画：透明 WebM 视频覆盖层 ====================
                     普通苏醒动画把图标弹出来之后，在此播放苦力怕爆炸视频（带透明通道）；
                     播到第 2 秒时下面的主页已经显示出来，视频播完即折叠本层。 -->
                <Grid x:Name="PanSplashVideo" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
                    <!-- 必须用 WebView2CompositionControl：普通 WebView2 是 HwndHost，无法做透明合成，
                         带 alpha 通道的 WebM 会变成一个不透明方块。 -->
                    <wv2:WebView2CompositionControl x:Name="BrowserSplashVideo" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <Grid x:Name="PanMsg" Grid.RowSpan="2" Background="#00000000" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
